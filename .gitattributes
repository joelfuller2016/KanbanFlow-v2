# Line-ending normalisation (#330).
#
# Without this file, `core.autocrlf=true` (the Windows default, and what this repo's
# clones actually carry) checks text out as CRLF while every Node and PowerShell tool
# here writes LF. Any tool that compares file bytes to regenerated bytes is then red on
# a clean clone through no fault of its own: `scripts/backlog-sync.mjs --check` reported
# all 273 body lines as simultaneously missing AND unexpected, plus a TAMPERED digest,
# on a file nobody had touched. A freshness guard that is red on arrival is a guard
# people learn to ignore, which silently retires it.
#
# `eol=lf` is deliberate rather than `eol=native`: the point is that the working tree
# holds the SAME bytes the generators write, on every platform. `native` would restore
# exactly the mismatch this closes.

# Default: git decides what is text, and text lands in the working tree as LF.
* text=auto eol=lf

# Explicit text, so a heuristic can never misclassify a source file as binary.
*.cs        text eol=lf
*.razor     text eol=lf
*.css       text eol=lf
*.js        text eol=lf
*.mjs       text eol=lf
*.map       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.csproj    text eol=lf
*.slnx      text eol=lf
*.svg       text eol=lf
*.gitignore text eol=lf
LICENSE     text eol=lf

# PowerShell tolerates LF, and keeping it LF means these files match what the
# generators and this repo's other tooling produce.
*.ps1       text eol=lf

# Binary — never touched by normalisation. Without these rules a renormalisation pass
# can corrupt them.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.zip       binary
*.dll       binary
*.exe       binary
*.db        binary
*.db-shm    binary
*.db-wal    binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
