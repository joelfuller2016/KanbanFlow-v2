@inject IJSRuntime JS
@implements IAsyncDisposable

<section aria-label="Workspace canvas" class="workspace-canvas-section">
    <p class="alert alert-danger" role="alert" hidden data-testid="canvas-input-error"></p>
    @if (_canvasError)
    {
        <p class="alert alert-warning" role="alert" data-testid="canvas-init-error">Canvas drag and resize are unavailable. Use the layout fields to adjust positions and sizes, or switch to Outline and back to Canvas to retry.</p>
    }
    <p class="small text-muted">Drag a card's title to move it; drag its corner to resize. Focus the title and use arrow keys to move 10px, or Shift + arrows to resize. The layout fields provide precise grouping, order and layer controls.</p>
    <div class="workspace-canvas-viewport" tabindex="0" aria-label="Scrollable canvas" data-testid="workspace-canvas-viewport">
        <div class="workspace-canvas" @ref="canvasElement" style="@CanvasStyle" data-busy="@(Busy ? "true" : "false")" data-workspace-id="@WorkspaceId" data-revision="@Revision" data-origin-x="@N(OriginX)" data-origin-y="@N(OriginY)" data-testid="workspace-canvas">
            <svg class="workspace-connectors" aria-hidden="true" width="@CanvasWidth" height="@CanvasHeight">
                @foreach (var connector in Document.Connectors)
                {
                    var from = Center(connector.FromComponentId);
                    var to = Center(connector.ToComponentId);
                    if (from is not null && to is not null)
                    {
                        <g @key="connector.Id"><line x1="@N(from.Value.X)" y1="@N(from.Value.Y)" x2="@N(to.Value.X)" y2="@N(to.Value.Y)" /><text x="@N((from.Value.X + to.Value.X) / 2)" y="@N((from.Value.Y + to.Value.Y) / 2)">@connector.Label</text></g>
                    }
                }
            </svg>
            @foreach (var placement in orderedPlacements)
            {
                var component = componentsById[placement.ComponentId];
                <article @key="placement.Id" class="workspace-canvas-card @(component.Type == "frame" ? "workspace-frame" : "") @(SelectedPlacementId == placement.Id ? "workspace-card-selected" : "")"
                         style="@PlacementStyle(placement)" data-placement-id="@placement.Id" data-component-id="@component.Id" data-parent-id="@placement.ParentId"
                         data-local-x="@N(placement.X)" data-local-y="@N(placement.Y)" data-width="@N(placement.Width)" data-height="@N(placement.Height)"
                         data-testid="canvas-placement-@placement.Id">
                    <button class="workspace-drag-handle" type="button" @onclick="() => OnSelect.InvokeAsync(new(component.Id, placement.Id))" data-testid="canvas-select-@placement.Id" aria-pressed="@(SelectedPlacementId == placement.Id ? "true" : "false")" aria-label="@($"Select or move {component.Title}")">
                        <span class="small text-muted">@component.Type</span><strong>@component.Title</strong>
                    </button>
                    <div class="workspace-card-preview"><WorkspaceComponentContent Component="component" /></div>
                    <span class="workspace-resize-handle" data-testid="canvas-resize-@placement.Id" aria-hidden="true">◢</span>
                </article>
            }
        </div>
    </div>
</section>
