<section class="workspace-panel" aria-labelledby="workspace-checkpoint-heading" data-testid="workspace-checkpoints">
    <h2 id="workspace-checkpoint-heading" class="h5">Leave a place to resume</h2>
    <p class="text-muted small">Saved per browser client and tab session. Other people and AI callers keep their own checkpoints.</p>
    <label class="form-label" for="checkpoint-objective">Current objective</label>
    <textarea id="checkpoint-objective" rows="2" class="form-control mb-2" value="@editing.Objective" @oninput="e => Change(editing with { Objective = Text(e) })" data-testid="checkpoint-objective"></textarea>
    <label class="form-label" for="checkpoint-completed">Completed changes (one per line)</label>
    <textarea id="checkpoint-completed" rows="2" class="form-control mb-2" value="@editing.CompletedChanges" @oninput="e => Change(editing with { CompletedChanges = Text(e) })" data-testid="checkpoint-completed"></textarea>
    <label class="form-label" for="checkpoint-questions">Open questions (one per line)</label>
    <textarea id="checkpoint-questions" rows="2" class="form-control mb-2" value="@editing.OpenQuestions" @oninput="e => Change(editing with { OpenQuestions = Text(e) })" data-testid="checkpoint-questions"></textarea>
    <label class="form-label" for="checkpoint-next">Next actions (one per line)</label>
    <textarea id="checkpoint-next" rows="3" class="form-control mb-2" value="@editing.NextActions" @oninput="e => Change(editing with { NextActions = Text(e) })" data-testid="checkpoint-next"></textarea>
    <fieldset class="mb-3"><legend class="h6">Focus components</legend>
        @foreach (var c in Context.Document.Components)
        {
            <label class="d-block" @key="c.Id"><input type="checkbox" class="form-check-input me-2" checked="@editing.FocusedComponentIds.Contains(c.Id)" @onchange="e => FocusChanged(c.Id, (bool)(e.Value ?? false))" />@c.Title</label>
        }
    </fieldset>
    <button class="btn btn-primary" disabled="@(Busy || string.IsNullOrEmpty(ClientId))" @onclick="Save" data-testid="checkpoint-save">Save resume checkpoint</button>
    <p class="text-muted small mt-2">Acknowledges changes through activity @Context.LastActivityId. Client <code>@ClientId</code> · session <code>@SessionId</code>.</p>
    <details class="mt-3"><summary>Saved checkpoints (@Context.Document.Checkpoints.Count)</summary>
        @foreach (var checkpoint in Context.Document.Checkpoints.OrderByDescending(c => c.UpdatedAt))
        {
            <article class="border-top pt-2 mt-2" @key="(checkpoint.ClientId, checkpoint.SessionId)" data-testid="saved-checkpoint-@checkpoint.ClientId-@checkpoint.SessionId">
                <p class="small text-muted">@checkpoint.Actor · @checkpoint.UpdatedAt.ToLocalTime().ToString("g") · through @checkpoint.LastAcknowledgedActivityId</p>
                <p class="workspace-preserve-text">@checkpoint.Objective</p>
                <p class="small">Next actions</p><ul>@foreach (var action in checkpoint.NextActions) { <li class="workspace-preserve-text">@action</li> }</ul>
                <button class="btn btn-outline-secondary btn-sm" @onclick="() => Resume(checkpoint)" data-testid="checkpoint-resume-@checkpoint.ClientId-@checkpoint.SessionId">Use this resume context</button>
            </article>
        }
    </details>
</section>

@code {
    [Parameter, EditorRequired] public IdeaWorkspaceContext Context { get; set; } = default!;
    [Parameter, EditorRequired] public WorkspaceCheckpointDraft Draft { get; set; } = default!;
    [Parameter] public string ClientId { get; set; } = "";
    [Parameter] public string SessionId { get; set; } = "";
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<WorkspaceCheckpointDraft> OnDraftChanged { get; set; }
    [Parameter] public EventCallback<WorkspaceSelection> OnSelect { get; set; }
    [Parameter] public EventCallback<WorkspaceUiCommand> OnCommand { get; set; }
    private readonly WorkspaceDraftInput<WorkspaceCheckpointDraft> input = new(new());
    private WorkspaceCheckpointDraft editing => input.Value;
    protected override void OnParametersSet() => input.Receive(Draft, Context.WorkspaceId, Context.Revision);
    private static string Text(ChangeEventArgs e) => e.Value?.ToString() ?? "";
    private Task Change(WorkspaceCheckpointDraft draft) => input.ChangeAsync(draft, OnDraftChanged);
    private Task FocusChanged(string id, bool selected) => Change(editing with { FocusedComponentIds = selected ? [.. editing.FocusedComponentIds.Where(i => i != id), id] : [.. editing.FocusedComponentIds.Where(i => i != id)] });
    private Task Save() => OnCommand.InvokeAsync(WorkspaceUiCommand.Create("save_checkpoint", new { clientId = ClientId, sessionId = SessionId, objective = editing.Objective, focusedComponentIds = editing.FocusedComponentIds, completedChanges = WorkspaceUiText.Lines(editing.CompletedChanges), openQuestions = WorkspaceUiText.Lines(editing.OpenQuestions), nextActions = WorkspaceUiText.Lines(editing.NextActions), lastAcknowledgedActivityId = Context.LastActivityId }, Context.Revision));
    private async Task Resume(IdeaWorkspaceCheckpoint checkpoint)
    {
        await Change(new() { Objective = checkpoint.Objective, CompletedChanges = string.Join('\n', checkpoint.CompletedChanges), OpenQuestions = string.Join('\n', checkpoint.OpenQuestions), NextActions = string.Join('\n', checkpoint.NextActions), FocusedComponentIds = [.. checkpoint.FocusedComponentIds] });
        var componentId = checkpoint.FocusedComponentIds.FirstOrDefault(id => Context.Document.Components.Any(c => c.Id == id));
        if (componentId is not null) await OnSelect.InvokeAsync(new(componentId, Context.Document.Placements.FirstOrDefault(p => p.ComponentId == componentId)?.Id));
    }
}
