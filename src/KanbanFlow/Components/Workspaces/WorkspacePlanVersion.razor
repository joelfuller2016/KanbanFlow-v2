<div class="mt-3">
    <h4 class="h6">@Plan.Title</h4>
    <p class="small text-muted">@Plan.CreatedBy · @Plan.CreatedAt.ToLocalTime().ToString("g")</p>
    <ol>
        @foreach (var item in Plan.Items)
        {
            <li @key="item.Id" class="mb-3"><strong>@item.Title</strong><MarkdownContent Markdown="@item.Description" EmptyText="No description." />
                @if (item.AcceptanceCriteria.Count != 0) { <ul>@foreach (var criterion in item.AcceptanceCriteria) { <li class="workspace-preserve-text">@criterion</li> }</ul> }
                @if (item.DependsOn.Count != 0) { <p class="small text-muted">Depends on: @string.Join(", ", item.DependsOn.Select(id => Plan.Items.FirstOrDefault(i => i.Id == id)?.Title ?? id))</p> }
                @if (item.Provenance is { } origin) { <p class="small text-muted">From <a href="@WorkspaceUiText.Url(origin.SourceWorkspaceId)">@origin.SourceWorkspaceId</a> · @origin.SourceItemId</p> }
                @if (item.PublishedTaskId is { } taskId)
                {
                    <div class="d-flex flex-wrap align-items-center gap-2 small"><span>Published task #@taskId</span>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => OnInspectTask.InvokeAsync(taskId)" data-testid="@(Current ? $"plan-inspect-task-{taskId}" : $"plan-inspect-task-history-{Plan.Id}-{taskId}")">Read current task status</button>
                        @if (KanbanUrl is not null) { <a href="@KanbanUrl">Open Kanban ↗</a> }
                    </div>
                }
            </li>
        }
    </ol>
</div>

@code {
    [Parameter, EditorRequired] public IdeaWorkspacePlanRevision Plan { get; set; } = default!;
    [Parameter] public string? KanbanUrl { get; set; }
    [Parameter] public EventCallback<int> OnInspectTask { get; set; }
    [Parameter] public bool Current { get; set; }
}
