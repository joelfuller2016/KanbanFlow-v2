@* One idea card for the inbox grid (#180 Phase 4). Mirrors Home.razor's project card:
   a shadow-sm card with a three-dots actions dropdown (Edit · Promote · Delete), a clamped
   markdown body preview, and a footer row of status / priority badges + a promoted link. *@
<div class="card h-100 shadow-sm" data-testid="idea-card-@Idea.Id">
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <h5 class="card-title mb-0" data-testid="idea-card-title-@Idea.Id">@Idea.Title</h5>
            <div class="dropdown">
                <button class="btn btn-sm btn-link text-muted p-0" data-bs-toggle="dropdown" aria-expanded="false"
                        aria-label="Open idea actions for @Idea.Title" data-testid="idea-card-menu-@Idea.Id">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-three-dots-vertical" viewBox="0 0 16 16" aria-hidden="true">
                        <path d="M9.5 13a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0m0-5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0m0-5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0"/>
                    </svg>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <button class="dropdown-item" @onclick="() => OnEdit.InvokeAsync(Idea)" data-testid="idea-card-edit-@Idea.Id">Edit</button>
                    </li>
                    @if (Idea.Status != IdeaStatus.Promoted)
                    {
                        <li>
                            <button class="dropdown-item" @onclick="() => OnPromote.InvokeAsync(Idea)" data-testid="idea-card-promote-@Idea.Id">Promote</button>
                        </li>
                    }
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        <button class="dropdown-item text-danger" @onclick="() => OnDelete.InvokeAsync(Idea)" data-testid="idea-card-delete-@Idea.Id">Delete</button>
                    </li>
                </ul>
            </div>
        </div>

        <MarkdownContent Markdown="@Idea.Body"
                         CssClass="card-text text-muted small project-card-description"
                         EmptyText="No details yet." />

        <div class="mt-auto pt-3">
            <div class="d-flex flex-wrap align-items-center gap-2">
                <span class="badge @IdeaBadge.StatusClass(Idea.Status)" data-testid="idea-card-status-@Idea.Id">@Idea.Status</span>
                @if (Idea.Priority is TaskPriority priority)
                {
                    <span class="badge @IdeaBadge.PriorityClass(priority)" data-testid="idea-card-priority-@Idea.Id">@priority</span>
                }
                @foreach (var tag in tags)
                {
                    <span class="badge bg-light text-dark border">#@tag</span>
                }
            </div>
            @if (Idea.Status == IdeaStatus.Promoted && Idea.PromotedProjectId is int projectId)
            {
                <a class="d-inline-flex align-items-center mt-2 small" href="@($"/project/{projectId}")" data-testid="idea-card-project-link-@Idea.Id">
                    Open project
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-arrow-right ms-1" viewBox="0 0 16 16" aria-hidden="true">
                        <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8"/>
                    </svg>
                </a>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Idea Idea { get; set; } = default!;
    [Parameter] public EventCallback<Idea> OnEdit { get; set; }
    [Parameter] public EventCallback<Idea> OnDelete { get; set; }
    [Parameter] public EventCallback<Idea> OnPromote { get; set; }

    // Computed once per parameter change rather than on every render (Idea is a parameter).
    private string[] tags = [];

    protected override void OnParametersSet() =>
        tags = string.IsNullOrWhiteSpace(Idea.Tags)
            ? []
            : Idea.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
}
