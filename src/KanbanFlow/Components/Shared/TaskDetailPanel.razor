    // ── Comments ──

    private async Task LoadCommentsAsync(int taskId, long loadVersion)
    {
        commentsLoading = true;
        commentsError = null;

        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var loadedComments = await db.TaskComments
                .Where(c => c.TaskItemId == taskId)
                .AsNoTracking()
                .OrderBy(c => c.CreatedAt)
                .ThenBy(c => c.Id)
                .ToListAsync();

            if (IsCurrentCommentLoad(taskId, loadVersion))
            {
                comments = loadedComments;
            }
        }
        catch
        {
            if (IsCurrentCommentLoad(taskId, loadVersion))
            {
                commentsError = "Unable to load comments.";
                comments = [];
            }
        }
        finally
        {
            if (IsCurrentCommentLoad(taskId, loadVersion))
            {
                commentsLoading = false;
            }
        }
    }

    private async Task AddCommentAsync()
    {
        if (Task is null || string.IsNullOrWhiteSpace(newCommentText)) return;

        var taskId = Task.Id;
        var saveVersion = ++commentSaveVersion;
        addingComment = true;
        commentsError = null;

        try
        {
            var comment = new TaskComment
            {
                TaskItemId = taskId,
                Text = newCommentText.Trim(),
                Author = "You",
                Type = newCommentType,
                CreatedAt = DateTime.UtcNow
            };

            using var db = await DbFactory.CreateDbContextAsync();
            db.TaskComments.Add(comment);
            await db.SaveChangesAsync();

            if (IsCurrentCommentSave(taskId, saveVersion))
            {
                comments.Add(comment);
                comments = comments.OrderBy(c => c.CreatedAt).ThenBy(c => c.Id).ToList();
                newCommentText = null;
                newCommentType = CommentType.Note;
            }

            await OnTaskUpdated.InvokeAsync();
        }
        catch
        {
            if (IsCurrentCommentSave(taskId, saveVersion))
            {
                commentsError = "Unable to add comment.";
            }
        }
        finally
        {
            if (IsCurrentCommentSave(taskId, saveVersion))
            {
                addingComment = false;
            }
        }
    }

    private bool IsCurrentCommentLoad(int taskId, long loadVersion) =>
        loadedCommentsTaskId == taskId && commentLoadVersion == loadVersion;

    private bool IsCurrentCommentSave(int taskId, long saveVersion) =>
        Task?.Id == taskId && loadedCommentsTaskId == taskId && commentSaveVersion == saveVersion;

    // ── Delete task ──

    private async Task ConfirmDeleteAsync()
    {
        if (Task is null) return;

        var taskId = Task.Id;

        using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.Tasks.FindAsync(taskId);
        if (entity is not null)
        {
            db.Tasks.Remove(entity);
            await db.SaveChangesAsync();
        }

        confirmingDelete = false;
        await OnTaskDeleted.InvokeAsync(taskId);
    }

    // ── Show in outline ──

    private async Task ScrollToOutline()
    {
        if (Task is not null)
        {
            await JS.InvokeVoidAsync("eval", $"document.querySelector('[data-task-id=\"{Task.Id}\"]')?.scrollIntoView({{behavior:'smooth',block:'center'}})");
        }
    }

    // ── Helpers ──

    private IReadOnlyList<TaskDependency> OrderedDependencies => Task?.Dependencies
        .OrderBy(d => d.DependsOnTaskItem?.Status == WorkStatus.Done)
        .ThenBy(d => d.DependsOnTaskItem?.Name ?? string.Empty)
        .ThenBy(d => d.DependsOnTaskItemId)
        .ToList() ?? [];

    private bool HasIncompleteBlockers => Task?.Dependencies
        .Any(d => d.DependsOnTaskItem is not null && d.DependsOnTaskItem.Status != WorkStatus.Done) == true;

    private static string GetStatusDisplayName(WorkStatus status) => status switch
    {
        WorkStatus.Backlog => "Backlog",
        WorkStatus.Todo => "To Do",
        WorkStatus.InProgress => "In Progress",
        WorkStatus.Review => "Review",
        WorkStatus.Done => "Done",
        _ => status.ToString()
    };

    private static string GetStatusDisplayName(WorkStatus? status) => status switch
    {
        WorkStatus.Backlog => "Backlog",
        WorkStatus.Todo => "To Do",
        WorkStatus.InProgress => "In Progress",
        WorkStatus.Review => "Review",
        WorkStatus.Done => "Done",
        _ => "Unknown"
    };

