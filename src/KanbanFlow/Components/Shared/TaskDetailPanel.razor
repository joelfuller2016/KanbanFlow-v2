        }
    }

    // ── Assignee change ──

    private async Task OnAssigneeChanged(ChangeEventArgs e)
    {
        if (Task is null) return;
        var newAssignee = e.Value?.ToString()?.Trim();
        if (newAssignee == Task.Assignee) return;

        try
        {
            // Routed through ITaskService.UpdateAsync (closes UI half of #88 for assignee).
            // Pass empty string to clear (matches SaveDescriptionAsync's convention; the service
            // distinguishes "not provided" (null) from "clear" (empty)).
            var assigneeArg = string.IsNullOrWhiteSpace(newAssignee) ? string.Empty : newAssignee;
            var updated = await TaskSvc.UpdateAsync(Task.Id, new TaskUpdate(Assignee: assigneeArg), actor: "User");
            Task.Assignee = updated.Assignee;
            Task.UpdatedAt = updated.UpdatedAt;

            await OnTaskUpdated.InvokeAsync();
        }
        catch (TaskNotFoundException)
        {
            await OnTaskUpdated.InvokeAsync();
        }
    }

