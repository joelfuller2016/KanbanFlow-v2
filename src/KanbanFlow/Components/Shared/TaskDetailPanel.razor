    private async Task ToggleAcceptanceCriterionAsync(AcceptanceCriterion criterion)
    {
        criterion.Completed = !criterion.Completed;
        criterion.UpdatedAt = DateTime.UtcNow;

        using var db = await DbFactory.CreateDbContextAsync();
        db.AcceptanceCriteria.Attach(criterion);
        db.Entry(criterion).Property(c => c.Completed).IsModified = true;
        db.Entry(criterion).Property(c => c.UpdatedAt).IsModified = true;
        await db.SaveChangesAsync();

        await OnTaskUpdated.InvokeAsync();
    }

    private async Task DeleteAcceptanceCriterionAsync(AcceptanceCriterion criterion)
    {
        if (Task is null) return;

        Task.AcceptanceCriteria.Remove(criterion);

        using var db = await DbFactory.CreateDbContextAsync();
        db.AcceptanceCriteria.Remove(db.AcceptanceCriteria.Attach(criterion).Entity);
        await db.SaveChangesAsync();

        await OnTaskUpdated.InvokeAsync();
    }

    // ── Comments ──

    private async Task LoadCommentsAsync(int taskId, long loadVersion)
    {
        commentsLoading = true;
        commentsError = null;

        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var loadedComments = await db.TaskComments
                .Where(c => c.TaskItemId == taskId)
                .AsNoTracking()
                .OrderBy(c => c.CreatedAt)
                .ThenBy(c => c.Id)
                .ToListAsync();

            if (IsCurrentCommentLoad(taskId, loadVersion))
            {
                comments = loadedComments;
            }
        }
        catch
        {
            if (IsCurrentCommentLoad(taskId, loadVersion))
            {
                commentsError = "Unable to load comments.";
                comments = [];
            }
        }
        finally
        {
            if (IsCurrentCommentLoad(taskId, loadVersion))
            {
                commentsLoading = false;
            }
        }
    }

    private async Task AddCommentAsync()
    {
        if (Task is null || string.IsNullOrWhiteSpace(newCommentText)) return;

        var taskId = Task.Id;
        var saveVersion = ++commentSaveVersion;
        addingComment = true;
        commentsError = null;

        try
        {
            // Route the comment through ITaskService so the UI emits a TaskCommentAdded
            // audit event identical to the REST/MCP surfaces (#88).
            var comment = await TaskSvc.AddCommentAsync(
                taskId, newCommentText, author: "User", type: newCommentType, actor: "User");

            if (IsCurrentCommentSave(taskId, saveVersion))
            {
                comments.Add(comment);
                comments = comments.OrderBy(c => c.CreatedAt).ThenBy(c => c.Id).ToList();
                newCommentText = null;
                newCommentType = CommentType.Note;
                // AddCommentAsync writes a paired TaskCommentAdded event but does NOT touch
                // Task.UpdatedAt, so OnParametersSetAsync's signal never fires here. Without this
                // the timeline would show the comment now and its shadow event on the next open.
                activityRefreshToken++;
            }

            await OnTaskUpdated.InvokeAsync();
        }
        catch
        {
            if (IsCurrentCommentSave(taskId, saveVersion))
            {
                commentsError = "Unable to add comment.";
            }
        }
        finally
        {
            if (IsCurrentCommentSave(taskId, saveVersion))
            {
                addingComment = false;
            }
        }
    }

    private bool IsCurrentCommentLoad(int taskId, long loadVersion) =>
        loadedCommentsTaskId == taskId && commentLoadVersion == loadVersion;

    private bool IsCurrentCommentSave(int taskId, long saveVersion) =>
        Task?.Id == taskId && loadedCommentsTaskId == taskId && commentSaveVersion == saveVersion;

    // ── Delete task ──

    private async Task ConfirmDeleteAsync()
    {
        if (Task is null) return;

        var taskId = Task.Id;

        // Route deletion through ITaskService so the UI emits a TaskDeleted audit event
        // and performs the FK-safe child cleanup (leaf-first subtasks + acceptance
        // criteria) identical to the REST/MCP surfaces (#88).
        try
        {
            await TaskSvc.DeleteAsync(taskId, actor: "User");
        }
        catch (TaskNotFoundException)
        {
            // Already deleted by another circuit/request — treat as success.
        }

        confirmingDelete = false;
        await OnTaskDeleted.InvokeAsync(taskId);
    }

    // ── Show in outline ──

    private async Task ScrollToOutline()
    {
        if (Task is not null)
        {
            await JS.InvokeVoidAsync("eval", $"document.querySelector('[data-task-id=\"{Task.Id}\"]')?.scrollIntoView({{behavior:'smooth',block:'center'}})");
        }
    }

    // ── Helpers ──

    private IReadOnlyList<TaskDependency> OrderedDependencies => Task?.Dependencies
        .OrderBy(d => d.DependsOnTaskItem?.Status == WorkStatus.Done)
        .ThenBy(d => d.DependsOnTaskItem?.Name ?? string.Empty)
        .ThenBy(d => d.DependsOnTaskItemId)
        .ToList() ?? [];

    private bool HasIncompleteBlockers => Task?.Dependencies
        .Any(d => d.DependsOnTaskItem is not null && d.DependsOnTaskItem.Status != WorkStatus.Done) == true;

    private static string GetStatusDisplayName(WorkStatus status) => status switch
    {
        WorkStatus.Backlog => "Backlog",
        WorkStatus.Todo => "To Do",
        WorkStatus.InProgress => "In Progress",
        WorkStatus.Review => "Review",
        WorkStatus.Done => "Done",
        _ => status.ToString()
    };

    private static string GetStatusDisplayName(WorkStatus? status) => status switch
    {
        WorkStatus.Backlog => "Backlog",
        WorkStatus.Todo => "To Do",
        WorkStatus.InProgress => "In Progress",
        WorkStatus.Review => "Review",
        WorkStatus.Done => "Done",
        _ => "Unknown"
    };

    private static string GetStatusBadgeClass(WorkStatus? status) => status switch
    {
        WorkStatus.Done => "badge text-bg-success",
        WorkStatus.InProgress => "badge text-bg-primary",
        WorkStatus.Review => "badge text-bg-info",
        WorkStatus.Todo => "badge text-bg-warning",
        WorkStatus.Backlog => "badge text-bg-secondary",
        _ => "badge text-bg-light border text-dark"
    };

    private static string GetCommentTypeDisplayName(CommentType type) => type switch
    {
        CommentType.Comment => "Comment",
        CommentType.StatusChange => "Status",
        CommentType.FeatureChange => "Feature",
        CommentType.PriorityChange => "Priority",
        CommentType.AssigneeChange => "Assignee",
        _ => type.ToString()
    };

    private static readonly CommentType[] UserCommentTypes =
    [
        CommentType.Note,
        CommentType.Decision,
        CommentType.Question,
        CommentType.Blocked,
        CommentType.Handoff,
        CommentType.Verification
    ];

    // GetCommentTypeBadgeClass / GetCommentBorderClass lived here and coloured each comment row's
    // badge and left border. The rail replaced the row markup, so they became dead — but the
    // INFORMATION they carried did not. It moved to ActivityTimelineBuilder.CommentTone, which
    // maps the same CommentTypes onto the .kf-tl-* dot accents (Blocked → danger, Handoff →
    // warning, Verification → success, …). Deleted here rather than left orphaned.

    private TaskComment? GetLatestHandoffComment() => comments
        .Where(comment => comment.Type == CommentType.Handoff)
        .OrderByDescending(comment => comment.CreatedAt)
        .ThenByDescending(comment => comment.Id)
        .FirstOrDefault();
