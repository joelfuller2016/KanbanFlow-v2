        if (Task is null || e.Value is null) return;
        if (!int.TryParse(e.Value.ToString(), out var priorityInt)) return;
        // Reject undefined enum values (mirrors OnStatusChanged hardening for #89).
        if (!Enum.IsDefined(typeof(TaskPriority), priorityInt)) return;

        var newPriority = (TaskPriority)priorityInt;
