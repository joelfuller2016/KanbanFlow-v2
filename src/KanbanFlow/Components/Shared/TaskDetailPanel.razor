    private TaskComment? GetLatestHandoffComment() => comments
        .Where(comment => comment.Type == CommentType.Handoff)
        .OrderByDescending(comment => comment.CreatedAt)
        .ThenByDescending(comment => comment.Id)
        .FirstOrDefault();
