@inject IIdeaService IdeaSvc
@inject IJSRuntime JS
@implements IAsyncDisposable

@* Combined create + edit modal for an Idea (#180 Phase 4). One modal because an Idea has
   identical fields for create and edit — the only difference is the edit-only Status select
   and the title text — exactly like Home.razor's create/edit project modal keyed on Id == 0.
   Accessibility (focus-trap + Esc + focus-restore) mirrors AddItemModal verbatim via
   KanbanFlow.initDialog. *@
<div class="modal fade @(IsOpen ? "show" : "")" tabindex="-1" data-testid="idea-modal"
     style="display: @(IsOpen ? "block" : "none");"
     @onclick="HandleBackdropClick" @onclick:stopPropagation="false">
    <div class="modal-dialog modal-lg" @ref="dialogRef" role="dialog" aria-modal="true" aria-labelledby="idea-modal-title" @onclick:stopPropagation="true">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="idea-modal-title">@(IsNew ? "New idea" : "Edit idea")</h5>
                <button type="button" class="btn-close" @onclick="Close" aria-label="Close idea dialog" data-testid="idea-close-button"></button>
            </div>
            <div class="modal-body">
                @if (errorMessage is not null)
                {
                    <div class="alert alert-danger alert-dismissible fade show py-2 small" role="alert" aria-live="assertive" aria-atomic="true">
                        @errorMessage
                        <button type="button" class="btn-close btn-close-sm" @onclick="() => errorMessage = null" aria-label="Dismiss error"></button>
                    </div>
                }

                @* Title (required) *@
                <div class="mb-3">
                    <label class="form-label small text-muted mb-1" for="idea-title">Title <span class="text-danger">*</span></label>
                    <input id="idea-title" type="text" class="form-control" maxlength="500" placeholder="What's the idea?"
                           data-dialog-autofocus="true" data-testid="idea-title-input"
                           @bind="title" @bind:event="oninput"
                           @onkeydown="HandleKeyDown" />
                    @if (showTitleRequired)
                    {
                        <div class="text-danger small mt-1" data-testid="idea-title-validation">Title is required.</div>
                    }
                </div>

                @* Body (markdown) *@
                <div class="mb-3">
                    <label class="form-label small text-muted mb-1" for="idea-body">Body</label>
                    <textarea id="idea-body" class="form-control form-control-sm" rows="4" placeholder="Brain-dump the idea..."
                              data-testid="idea-body-input" @bind="body"></textarea>
                    <div class="form-text small">Markdown supported.</div>
                </div>

                @* Plan (markdown) *@
                <div class="mb-3">
                    <label class="form-label small text-muted mb-1" for="idea-plan">Plan</label>
                    <textarea id="idea-plan" class="form-control form-control-sm" rows="6" placeholder="Problem · approach · scope · value..."
                              data-testid="idea-plan-input" @bind="plan"></textarea>
                    <div class="form-text small">Markdown supported.</div>
                </div>

                @* Tags *@
                <div class="mb-3">
                    <label class="form-label small text-muted mb-1" for="idea-tags">Tags</label>
                    <input id="idea-tags" type="text" class="form-control form-control-sm" placeholder="comma,separated,tags"
                           data-testid="idea-tags-input" @bind="tags" />
                </div>

                @* Priority (nullable → explicit None option) *@
                <div class="mb-3">
                    <label class="form-label small text-muted mb-1" for="idea-priority">Priority</label>
                    <select id="idea-priority" class="form-select form-select-sm" data-testid="idea-priority-select" @bind="priorityRaw">
                        <option value="">None</option>
                        @foreach (var p in Enum.GetValues<TaskPriority>())
                        {
                            <option value="@((int)p)">@p</option>
                        }
                    </select>
                </div>

                @* Status — edit only (create always starts New).

                   `Promoted` is DERIVED and TERMINAL (#283/#285), and the SELECT ITSELF is disabled for a
                   promoted idea — not merely its `Promoted` <option>. A disabled option only stops that
                   option being re-picked; it leaves the select live, so a user could still open a promoted
                   idea and choose `New`, sending the idea out of Promoted with PromotedProjectId left
                   dangling (nothing can ever clear it — IdeaUpdate has no such field). Disabling the whole
                   control is what actually makes the status un-changeable. The promoted <option> is still
                   RENDERED so the select displays the idea's real status rather than falling back to "New".

                   For any non-promoted idea the select is live, minus the `Promoted` option — you cannot
                   promote from here either; only PromoteAsync may write it, because it alone also creates
                   the Project and links it. Both directions are enforced for real at the service
                   (IdeaService.IsStatusTransitionAllowed); this is the UI half. *@
                @if (!IsNew)
                {
                    <div class="mb-3">
                        <label class="form-label small text-muted mb-1" for="idea-status">Status</label>
                        <select id="idea-status" class="form-select form-select-sm" data-testid="idea-status-select"
                                disabled="@isPromoted" @bind="status">
                            @* `Promoted` is rendered ONLY for an idea that already has it — so the select
                               displays the idea's real status instead of falling back to "New" — and is
                               never offered to anything else. No option-level `disabled` is needed: when
                               the idea is promoted the whole select is disabled, and when it isn't, this
                               option isn't rendered at all. *@
                            @foreach (var s in Enum.GetValues<IdeaStatus>())
                            {
                                if (s != IdeaStatus.Promoted || isPromoted)
                                {
                                    <option value="@((int)s)">@s</option>
                                }
                            }
                        </select>
                        @if (isPromoted)
                        {
                            <div class="form-text small" data-testid="idea-status-promoted-hint">
                                Promotion is permanent — this idea's status can't be changed.
                                Every other field is still editable.
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" @onclick="Close" data-testid="idea-cancel-button">Cancel</button>
                <button type="button" class="btn btn-primary btn-sm" @onclick="SaveIdea"
                        data-testid="idea-save-button" disabled="@(isSaving || isLoading || string.IsNullOrWhiteSpace(title))">
                    @if (isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    }
                    Save
                </button>
            </div>
        </div>
    </div>
</div>

@if (IsOpen)
{
    <div class="modal-backdrop fade show"></div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }

    /// <summary>The idea being edited, or <c>null</c> to create a new idea.</summary>
    [Parameter] public int? EditIdeaId { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool IsNew => EditIdeaId is null;

    private int? expectedWorkflowVersion;
    private string? title;
    private string? body;
    private string? plan;
    private string? tags;
    // Bound to the priority <select>. "" = None (null), otherwise the enum's int value as a string.
    // A string intermediary is the robust way to give a nullable enum select a blank "None" option.
    private string priorityRaw = "";
    private int status; // edit-only; backs the IdeaStatus select by its int value
    // True when the loaded idea is ALREADY promoted. `Promoted` is derived and terminal (#283/#285):
    // it is never an offered choice, it must still DISPLAY for an idea that has it, its select is
    // disabled so the status cannot be changed at all, and no status is ever sent back to UpdateAsync
    // (which refuses every transition across the Promoted boundary). See SelectedStatus.
    private bool isPromoted;
    private string? errorMessage;
    private bool showTitleRequired;
    private bool isSaving;

    private bool wasOpen;
    private bool isLoading;
    private int? loadedIdeaId;
    private int loadGeneration;
    private CancellationTokenSource editCancellation = new();
    private bool disposed;

    protected override async Task OnParametersSetAsync()
    {
        if (disposed) return;
        if (!IsOpen) { ++loadGeneration; editCancellation.Cancel(); loadedIdeaId = null; expectedWorkflowVersion = null; }
        if (IsOpen && (!wasOpen || loadedIdeaId != EditIdeaId))
        {
            var generation = ++loadGeneration;
            editCancellation.Cancel(); editCancellation.Dispose(); editCancellation = new();
            wasOpen = true;
            isLoading = false;
            loadedIdeaId = EditIdeaId;
            ResetFields();
            // Modal just opened — reset transient UI state.
            errorMessage = null;
            showTitleRequired = false;
            isSaving = false;

            if (EditIdeaId is int id)
            {
                // Keep fields, identity and version from one load. A target switch reloads
                // even when the parent keeps the modal open.
                isLoading = true;
                var ct = editCancellation.Token;
                try { await LoadIdea(id, generation, ct); }
                catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
                finally { if (generation == loadGeneration) isLoading = false; }
            }
            else
            {
                // Create: start from a blank form.
                ResetFields();
            }
        }

        wasOpen = IsOpen;
    }

    private void ResetFields()
    {
        expectedWorkflowVersion = null;
        title = null;
        body = null;
        plan = null;
        tags = null;
        priorityRaw = "";
        status = (int)IdeaStatus.New;
        isPromoted = false;
    }

    private async Task LoadIdea(int id, int generation, CancellationToken ct)
    {
        var idea = await IdeaSvc.GetByIdAsync(id, ct);
        if (!IsOpen || EditIdeaId != id || generation != loadGeneration) return;
        if (idea is null)
        {
            errorMessage = "This idea no longer exists.";
            StateHasChanged();
            return;
        }
        expectedWorkflowVersion = idea.WorkflowVersion;
        title = idea.Title;
        body = idea.Body;
        plan = idea.Plan;
        tags = idea.Tags;
        priorityRaw = idea.Priority is TaskPriority p ? ((int)p).ToString() : "";
        status = (int)idea.Status;
        isPromoted = idea.Status == IdeaStatus.Promoted;
        StateHasChanged();
    }

    private TaskPriority? SelectedPriority =>
        string.IsNullOrEmpty(priorityRaw) ? null : (TaskPriority)int.Parse(priorityRaw);

    // The status to SEND on save, or null for "leave unchanged".
    //
    // A promoted idea NEVER sends a status. Keyed on `isPromoted` — the IDEA's state — and not on the
    // currently-SELECTED value, which was the bug (#285, CodeRabbit on PR #286): keying on the selected
    // value only nulled out while the select still read `Promoted`, so a user who changed it to `New`
    // sent `New` and moved the idea out of Promoted with its PromotedProjectId left dangling. The select
    // is disabled for a promoted idea, so this is now belt-and-braces — but it is the belt: no UI path
    // can send a status for a promoted idea, whatever the control does.
    //
    // Sending null (not the status) is also what keeps a promoted idea EDITABLE: UpdateAsync refuses any
    // status transition across the Promoted boundary, so echoing `Promoted` back would throw and block
    // the whole save — title, body, tags and all. null = "leave unchanged" lets the rest through.
    // (For a non-promoted idea `status` can never be Promoted: that option is not rendered.)
    private IdeaStatus? SelectedStatus =>
        isPromoted ? null : (IdeaStatus)status;

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        // Escape is handled by the dialog focus-trap (KanbanFlow.initDialog → CloseFromJs);
        // here we only handle Enter-to-save from the title field.
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(title))
            await SaveIdea();
    }

    private async Task SaveIdea()
    {
        if (disposed || isSaving || isLoading || !IsOpen || loadedIdeaId != EditIdeaId) return;
        var generation = loadGeneration;
        var ideaId = loadedIdeaId;
        var ct = editCancellation.Token;
        if (ideaId is not null && expectedWorkflowVersion is null) return;
        if (string.IsNullOrWhiteSpace(title))
        {
            showTitleRequired = true;
            return;
        }

        showTitleRequired = false;
        errorMessage = null;
        isSaving = true;

        try
        {
            if (IsNew)
            {
                await IdeaSvc.CreateAsync(
                    new IdeaCreate(title.Trim(), body, plan, tags, SelectedPriority), actor: "User", ct: ct);
            }
            else
            {
                await IdeaSvc.UpdateAsync(ideaId!.Value,
                    new IdeaUpdate(
                        Title: title.Trim(),
                        Body: body,
                        Plan: plan,
                        Status: SelectedStatus,
                        Tags: tags,
                        Priority: SelectedPriority,
                        ExpectedWorkflowVersion: expectedWorkflowVersion),
                    actor: "User", ct: ct);
            }

            if (generation != loadGeneration || !IsOpen || EditIdeaId != ideaId) return;
            await OnSaved.InvokeAsync();
            if (generation == loadGeneration && IsOpen && EditIdeaId == ideaId) await OnClose.InvokeAsync();
        }
        catch (ValidationException ex) when (generation == loadGeneration)
        {
            errorMessage = ex.Message;
        }
        catch (IdeaNotFoundException) when (generation == loadGeneration)
        {
            errorMessage = "This idea no longer exists. Close and refresh the list.";
        }
        catch (Exception ex)
        {
            if (generation != loadGeneration) return;
            // Surface unexpected failures (e.g. DbUpdateException, SQLite busy) inline rather
            // than letting them escape the @onclick handler and tear down the Blazor circuit.
            errorMessage = $"Save failed: {ex.Message}";
        }
        finally
        {
            if (generation == loadGeneration) isSaving = false;
        }
    }

    private async Task HandleBackdropClick() => await Close();

    private async Task Close() => await OnClose.InvokeAsync();

    // ── Accessible dialog (#166): focus-trap + Esc + focus restore via KanbanFlow.initDialog ──
    private ElementReference dialogRef;
    private DotNetObjectReference<IdeaModal>? _selfRef;
    private bool _dialogInited;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsOpen && !_dialogInited)
        {
            _dialogInited = true;   // set before the await so a re-render mid-init can't double-call
            _selfRef ??= DotNetObjectReference.Create(this);
            try { await JS.InvokeVoidAsync("KanbanFlow.initDialog", dialogRef, _selfRef); }
            catch (Microsoft.JSInterop.JSDisconnectedException) { /* circuit gone during teardown */ }
        }
        else if (!IsOpen && _dialogInited)
        {
            _dialogInited = false;
            await SafeDestroyDialogAsync();
        }
    }

    [JSInvokable]
    public Task CloseFromJs() => Close();

    private async Task SafeDestroyDialogAsync()
    {
        try { await JS.InvokeVoidAsync("KanbanFlow.destroyDialog", dialogRef); }
        catch (Microsoft.JSInterop.JSDisconnectedException) { /* circuit gone during teardown */ }
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        ++loadGeneration;
        editCancellation.Cancel(); editCancellation.Dispose();
        if (_dialogInited)
            await SafeDestroyDialogAsync();
        _selfRef?.Dispose();
    }
}
