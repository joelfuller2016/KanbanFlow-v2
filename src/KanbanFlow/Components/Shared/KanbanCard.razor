<div class="card mb-2 board-card @(HasIncompleteBlockers ? "board-card-blocked" : null)" data-testid="board-card-@Task.Id" data-task-id="@Task.Id"
     @onclick="() => OnOpenTaskDetail.InvokeAsync(Task)"
     style="border-left: 3px solid @GetPriorityBorderColor(Task.Priority); @(IsDone ? "opacity: 0.6;" : "")">
    <div class="card-body p-2">
        <div class="d-flex align-items-center">
            <input type="checkbox" class="form-check-input me-2 flex-shrink-0" style="margin-top: 0; cursor: pointer;"
                   checked="@IsDone"
                   @onchange="() => OnToggleTaskDone.InvokeAsync(Task)"
                   @onclick:stopPropagation="true"
                   @onkeydown:stopPropagation="true"
                   aria-label="Mark @Task.Name as @(IsDone ? "not done" : "done")"
                   data-testid="board-card-@Task.Id-done-checkbox" />
            <div class="d-flex align-items-center gap-1 flex-grow-1 overflow-hidden">
                <button type="button"
                        class="btn btn-link fw-medium small text-start p-0 text-decoration-none text-reset flex-grow-1 board-card-title @(IsDone ? "text-decoration-line-through text-muted" : "")"
                        @onclick="() => OnOpenTaskDetail.InvokeAsync(Task)"
                        @onclick:stopPropagation="true"
                        aria-label="Open task details for @Task.Name"
                        data-testid="board-card-@Task.Id-title">@Task.Name</button>
                @if (HasIncompleteBlockers)
                {
                    <span class="badge text-bg-danger board-card-blocked-badge flex-shrink-0"
                          title="Blocked by @IncompleteBlockers.Count unfinished task@(IncompleteBlockers.Count == 1 ? "" : "s")"
                          aria-label="Blocked by @IncompleteBlockers.Count unfinished task@(IncompleteBlockers.Count == 1 ? "" : "s")"
                          data-testid="board-card-@Task.Id-blocked-badge">
                        Blocked
                    </span>
                }
            </div>
        </div>

        @* -- The reveal (hover / focus-within) -------------------------------------------------
           A resting card shows a TRUNCATED title and nothing else, so two tasks whose names share
           a prefix are indistinguishable without opening the panel -- the reader had to click to
           find out whether it was worth clicking. Everything below is already on the card's own
           model; this spends vertical space only while the pointer (or keyboard focus) is on it.

           `board-card-reveal` collapses via `grid-template-rows: 0fr -> 1fr` rather than a
           `max-height` guess: a guessed max-height either clips a long excerpt or, set generously,
           makes the transition open with a long dead interval. The grid technique animates to the
           content's REAL height with no magic number. `min-height: 0` on the inner track is what
           lets the row actually reach zero (Grid's automatic minimum size is `auto`, not 0).

           `aria-hidden` is deliberately NOT set: the content stays in the accessibility tree at
           rest, so a screen-reader user is never gated on a hover they cannot perform, and
           `:focus-within` opens it visually for a keyboard user who tabs to the title. *@
        @if (HasReveal)
        {
            <div class="board-card-reveal">
                <div class="board-card-reveal-inner">
                    @if (!string.IsNullOrWhiteSpace(Excerpt))
                    {
                        <p class="board-card-excerpt mb-1" data-testid="board-card-@Task.Id-excerpt">@Excerpt</p>
                    }
                    @if (IssueUrl is not null)
                    {
                        <a href="@IssueUrl" target="_blank" rel="noopener noreferrer"
                           class="board-card-gh"
                           @onclick:stopPropagation="true"
                           title="Open @IssueLabel on GitHub"
                           aria-label="@IssueAriaLabel"
                           data-testid="board-card-@Task.Id-github">
                            <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" focusable="false"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" /></svg>
                            <span>@IssueLabel</span>
                        </a>
                    }
                </div>
            </div>
        }

        <div class="d-flex justify-content-between align-items-center mt-1 ps-4">
            @* #322 phase 3 -- `flex-shrink-0` so a long feature name can never squash the priority
               word, and `board-card-meta-label` so the label takes the REMAINING track instead of
               hugging its own text. Hugging it made the box exactly as wide as the text, which shaved
               the terminal glyph ("Dashboard" -> "Dashboarc") and made `text-truncate`s ellipsis
               impossible to trigger. `ms-1` is now a guaranteed gutter rather than one a long label
               could eat, which is what keeps the label off the badge. Full rationale in app.css. *@
            <span class="@GetPriorityBadgeClass(Task.Priority) flex-shrink-0">@Task.Priority</span>
            <small class="text-muted fst-italic text-truncate ms-1 board-card-meta-label" style="font-size: 0.7rem;" title="@Task.Feature.Name">@Task.Feature.Name</small>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public TaskItem Task { get; set; } = default!;
    [Parameter] public EventCallback<TaskItem> OnToggleTaskDone { get; set; }
    [Parameter] public EventCallback<TaskItem> OnOpenTaskDetail { get; set; }

    private bool IsDone => Task.Status == WorkStatus.Done;
    private IReadOnlyList<TaskDependency> IncompleteBlockers => Task.Dependencies
        .Where(d => d.DependsOnTaskItem is not null && d.DependsOnTaskItem.Status != WorkStatus.Done)
        .ToList();
    private bool HasIncompleteBlockers => IncompleteBlockers.Count > 0;

    // The mirrored-description reader lives in Services/MirroredDescription.cs, not here: this
    // project has no bUnit, so logic left in a `.razor` @code block is unreachable from a test.
    // Same reason IdeaBadge exists. The card only asks the questions; the parsing is pinned by
    // MirroredDescriptionTests.
    //
    // Resolved once per description change, NOT on every render — the same treatment, and for the
    // same reason, as EditItemModal's GitHub links. As expression-bodied properties these re-ran the
    // whole pipeline on every `@` reference: measured at ~9 regex passes and ~50 KB of allocation
    // per card per render, and the board holds 185 cards. `BoardFilterBar` binds `@oninput` with no
    // debounce and there is no `Virtualize`, so a filter keystroke re-renders every card on the
    // circuit's synchronization context — the cost multiplies by every character typed.
    private string? issueUrl;
    private string? issueLabel;
    private string? issueAriaLabel;
    private string? excerpt;
    private bool hasReveal;
    private string? parsedFrom;
    private bool parsedOnce;

    protected override void OnParametersSet()
    {
        // Reference equality is not enough: two tasks can share a description string, and a task's
        // description can change in place. Compare by value, and use a separate `parsedOnce` flag so
        // a genuinely null description is not re-parsed on every render.
        if (parsedOnce && string.Equals(parsedFrom, Task.Description, StringComparison.Ordinal)) return;

        parsedFrom = Task.Description;
        parsedOnce = true;
        issueUrl = MirroredDescription.IssueUrl(Task.Description);
        issueLabel = MirroredDescription.IssueLabel(Task.Description);
        issueAriaLabel = MirroredDescription.IssueAriaLabel(Task.Description);
        excerpt = MirroredDescription.Excerpt(Task.Description);
        hasReveal = issueUrl is not null || !string.IsNullOrWhiteSpace(excerpt);
    }

    private string? IssueUrl => issueUrl;
    private string? IssueLabel => issueLabel;
    private string? IssueAriaLabel => issueAriaLabel;
    private string? Excerpt => excerpt;
    private bool HasReveal => hasReveal;

    private static string GetPriorityBadgeClass(TaskPriority priority) => priority switch
    {
        TaskPriority.Low => "badge bg-secondary",
        TaskPriority.Medium => "badge bg-warning text-dark",
        TaskPriority.High => "badge bg-orange text-white",
        TaskPriority.Critical => "badge bg-danger",
        _ => "badge bg-secondary"
    };

    private static string GetPriorityBorderColor(TaskPriority priority) => priority switch
    {
        TaskPriority.Low => "#6c757d",
        TaskPriority.Medium => "#ffc107",
        TaskPriority.High => "#fd7e14",
        TaskPriority.Critical => "#dc3545",
        _ => "#6c757d"
    };
}
