<div class="card mb-2 board-card @(HasIncompleteBlockers ? "board-card-blocked" : null)" data-testid="board-card-@Task.Id" data-task-id="@Task.Id"
     @onclick="() => OnOpenTaskDetail.InvokeAsync(Task)"
     style="border-left: 3px solid @GetPriorityBorderColor(Task.Priority); @(IsDone ? "opacity: 0.6;" : "")">
    <div class="card-body p-2">
        <div class="d-flex align-items-center">
            <input type="checkbox" class="form-check-input me-2 flex-shrink-0" style="margin-top: 0; cursor: pointer;"
                   checked="@IsDone"
                   @onchange="() => OnToggleTaskDone.InvokeAsync(Task)"
                   @onclick:stopPropagation="true"
                   @onkeydown:stopPropagation="true"
                   aria-label="Mark @Task.Name as @(IsDone ? "not done" : "done")"
                   data-testid="board-card-@Task.Id-done-checkbox" />
            <div class="d-flex align-items-center gap-1 flex-grow-1 overflow-hidden">
                <button type="button"
                        class="btn btn-link fw-medium small text-start p-0 text-decoration-none text-reset flex-grow-1 text-truncate @(IsDone ? "text-decoration-line-through text-muted" : "")"
                        @onclick="() => OnOpenTaskDetail.InvokeAsync(Task)"
                        @onclick:stopPropagation="true"
                        aria-label="Open task details for @Task.Name"
                        data-testid="board-card-@Task.Id-title">@Task.Name</button>
                @if (HasIncompleteBlockers)
                {
                    <span class="badge text-bg-danger board-card-blocked-badge flex-shrink-0"
                          title="Blocked by @IncompleteBlockers.Count unfinished task@(IncompleteBlockers.Count == 1 ? "" : "s")"
                          aria-label="Blocked by @IncompleteBlockers.Count unfinished task@(IncompleteBlockers.Count == 1 ? "" : "s")"
                          data-testid="board-card-@Task.Id-blocked-badge">
                        Blocked
                    </span>
                }
            </div>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-1 ps-4">
            @* #322 phase 3 -- `flex-shrink-0` so a long feature name can never squash the priority
               word, and `board-card-meta-label` so the label takes the REMAINING track instead of
               hugging its own text. Hugging it made the box exactly as wide as the text, which shaved
               the terminal glyph ("Dashboard" -> "Dashboarc") and made `text-truncate`s ellipsis
               impossible to trigger. `ms-1` is now a guaranteed gutter rather than one a long label
               could eat, which is what keeps the label off the badge. Full rationale in app.css. *@
            <span class="@GetPriorityBadgeClass(Task.Priority) flex-shrink-0">@Task.Priority</span>
            <small class="text-muted fst-italic text-truncate ms-1 board-card-meta-label" style="font-size: 0.7rem;" title="@Task.Feature.Name">@Task.Feature.Name</small>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public TaskItem Task { get; set; } = default!;
    [Parameter] public EventCallback<TaskItem> OnToggleTaskDone { get; set; }
    [Parameter] public EventCallback<TaskItem> OnOpenTaskDetail { get; set; }

    private bool IsDone => Task.Status == WorkStatus.Done;
    private IReadOnlyList<TaskDependency> IncompleteBlockers => Task.Dependencies
        .Where(d => d.DependsOnTaskItem is not null && d.DependsOnTaskItem.Status != WorkStatus.Done)
        .ToList();
    private bool HasIncompleteBlockers => IncompleteBlockers.Count > 0;

    private static string GetPriorityBadgeClass(TaskPriority priority) => priority switch
    {
        TaskPriority.Low => "badge bg-secondary",
        TaskPriority.Medium => "badge bg-warning text-dark",
        TaskPriority.High => "badge bg-orange text-white",
        TaskPriority.Critical => "badge bg-danger",
        _ => "badge bg-secondary"
    };

    private static string GetPriorityBorderColor(TaskPriority priority) => priority switch
    {
        TaskPriority.Low => "#6c757d",
        TaskPriority.Medium => "#ffc107",
        TaskPriority.High => "#fd7e14",
        TaskPriority.Critical => "#dc3545",
        _ => "#6c757d"
    };
}
