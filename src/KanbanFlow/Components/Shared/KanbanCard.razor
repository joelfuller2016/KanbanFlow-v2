@using System.Text.RegularExpressions

@{
    var blockerCount = Task.Dependencies.Count(d =>
        d.DependsOnTaskItem is not null && d.DependsOnTaskItem.Status != WorkStatus.Done);
}

<div class="card mb-2 board-card @(blockerCount > 0 ? "board-card-blocked" : null)"
     data-testid="board-card-@Task.Id" data-task-id="@Task.Id"
     @onclick="() => OnOpenTaskDetail.InvokeAsync(Task)">
    <div class="card-body p-2">
        <div class="board-card-heading">
            <input type="checkbox" class="form-check-input board-card-done"
                   checked="@IsDone"
                   @onchange="() => OnToggleTaskDone.InvokeAsync(Task)"
                   @onclick:stopPropagation="true"
                   @onkeydown:stopPropagation="true"
                   aria-label="Mark @Task.Name as @(IsDone ? "not done" : "done")"
                   data-testid="board-card-@Task.Id-done-checkbox" />
            @* Keep the clamp on the inner span so it works in WebKit (#481). *@
            <button type="button"
                    class="btn text-start p-0 board-card-title @(IsDone ? "board-card-title-done" : null)"
                    @onclick="() => OnOpenTaskDetail.InvokeAsync(Task)"
                    @onclick:stopPropagation="true"
                    title="@Task.Name"
                    aria-label="Open task details for @Task.Name"
                    data-testid="board-card-@Task.Id-title"><span class="board-card-title-text">@DisplayTitle</span></button>
        </div>

        <div class="board-card-metadata">
            <div class="board-card-meta-row">
                <GitHubIssueBadge Links="Task.ExternalLinks"
                                  Description="@Task.Description"
                                  CssClass="board-card-gh"
                                  TestId="@($"board-card-{Task.Id}-github-link")" />
                <span class="badge board-card-priority"><span class="visually-hidden">Priority: </span>@Task.Priority</span>
                @if (Task.Feature is { } feature)
                {
                    <small class="fst-italic text-truncate board-card-meta-label" title="@feature.Name">@feature.Name</small>
                }
            </div>
            @if (blockerCount > 0 || !string.IsNullOrWhiteSpace(Task.Assignee))
            {
                <div class="board-card-meta-row board-card-meta-context">
                    @if (blockerCount > 0)
                    {
                        var blockers = $"{blockerCount} unfinished task{(blockerCount == 1 ? "" : "s")}";
                        <span class="badge board-card-blocked-badge"
                              title="Blocked by @blockers"
                              data-testid="board-card-@Task.Id-blocked-badge">Blocked<span class="visually-hidden"> by @blockers</span></span>
                    }
                    @if (!string.IsNullOrWhiteSpace(Task.Assignee))
                    {
                        <span class="text-truncate board-card-assignee" title="Assigned to @Task.Assignee">
                            <span class="visually-hidden">Assigned to </span>@Task.Assignee
                        </span>
                    }
                </div>
            }
        </div>

        @* app.css reveals the excerpt on hover or focus and holds card geometry during a drag. *@
        @if (!string.IsNullOrWhiteSpace(Excerpt))
        {
            <div class="board-card-reveal">
                <div class="board-card-reveal-inner">
                    <div class="board-card-reveal-content">
                        <p class="board-card-excerpt mb-1" data-testid="board-card-@Task.Id-excerpt">@Excerpt</p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public TaskItem Task { get; set; } = default!;
    [Parameter] public EventCallback<TaskItem> OnToggleTaskDone { get; set; }
    [Parameter] public EventCallback<TaskItem> OnOpenTaskDetail { get; set; }

    private static readonly Regex PriorityPrefix = new(
        @"\A(?:\[P[0-3]\]|P[0-3]\s*[:–—-])\s*",
        RegexOptions.IgnoreCase | RegexOptions.CultureInvariant);

    private bool IsDone => Task.Status == WorkStatus.Done;

    private string DisplayTitle
    {
        get
        {
            var title = Task.Name;
            // The sync adds "#<issue number> ". Use the same validated reference as the visible badge.
            if (!title.StartsWith('#') ||
                ExternalWorkItemPresentation.FindActiveGitHubIssue(Task.ExternalLinks, Task.Description) is not { } issue)
            {
                return title;
            }

            var issuePrefix = FormattableString.Invariant($"#{issue.Number} ");
            if (!title.StartsWith(issuePrefix, StringComparison.Ordinal))
                return title;

            var issueTitle = title[issuePrefix.Length..].TrimStart();
            if (issueTitle.Length == 0)
                return title;

            var priority = PriorityPrefix.Match(issueTitle);
            return priority.Success && priority.Length < issueTitle.Length
                ? issueTitle[priority.Length..]
                : issueTitle;
        }
    }

    private string? Excerpt;
    private string? parsedFrom;
    private bool parsedOnce;

    protected override void OnParametersSet()
    {
        // A filter keystroke re-renders every card. Only reparse the preview when its source changes.
        if (parsedOnce && string.Equals(parsedFrom, Task.Description, StringComparison.Ordinal))
            return;

        parsedFrom = Task.Description;
        parsedOnce = true;
        Excerpt = MirroredDescription.Excerpt(Task.Description);
    }
}
