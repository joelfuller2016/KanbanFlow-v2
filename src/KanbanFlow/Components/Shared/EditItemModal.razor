@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ITaskService TaskService
@inject IJSRuntime JS
@implements IAsyncDisposable

@* Bootstrap Modal for editing Projects, Features, and Tasks *@
<div class="modal fade @(IsOpen ? "show" : "")" tabindex="-1" data-testid="edit-item-modal"
     style="display: @(IsOpen ? "block" : "none");"
     @onclick="HandleBackdropClick" @onclick:stopPropagation="false">
    <div class="modal-dialog modal-lg modal-dialog-scrollable" @ref="dialogRef" role="dialog" aria-modal="true" aria-labelledby="edit-item-title" @onclick:stopPropagation="true">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="edit-item-title">Edit @GetItemTypeName()</h5>
                <button type="button" class="btn-close" @onclick="Close" aria-label="Close edit item modal" data-testid="edit-item-close-button"></button>
            </div>
            <div class="modal-body">
                @if (errorMessage is not null)
                {
                    <div class="alert alert-danger alert-dismissible fade show py-2 small" role="alert">
                        @errorMessage
                        <button type="button" class="btn-close btn-close-sm" @onclick="() => errorMessage = null"></button>
                    </div>
                }

                @* Name *@
                <div class="mb-3">
                    <label class="form-label small text-muted mb-1" for="edit-item-name">Name</label>
                    <input id="edit-item-name" type="text" class="form-control" data-dialog-autofocus="true" @bind="editName" @bind:event="oninput" />
                </div>

                @* Task description (#357). The SAME component TaskDetailPanel uses — read mode
                   renders markdown, one click swaps in the raw source. Deliberately not forked:
                   two copies is how this codebase ended up with two different clocks (#306).

                   No OnCommit here, and that is the one intentional difference between the two call
                   sites: this modal persists through its own Save Changes button, so the field only
                   keeps the buffer up to date (it raises ValueChanged on every keystroke). In this
                   explicit-save mode, blur intentionally stays in edit mode until the modal closes.

                   Project and Feature descriptions retain their existing textarea. Their editing UX
                   is outside this task-only issue; changing it here would broaden #357 silently. *@
                <div class="mb-3">
                    @if (EditMode == EditItemType.Task)
                    {
                        <EditableMarkdown ElementId="edit-item-description"
                                          TestId="edit-item-description"
                                          Label="Description"
                                          Rows="3"
                                          ResetToken="descriptionResetToken"
                                          @bind-Value="editDescription"
                                          @bind-Value:after="RefreshGitHubPullRequest" />
                    }
                    else
                    {
                        <label class="form-label small text-muted mb-1" for="edit-item-description">Description</label>
                        <textarea id="edit-item-description" class="form-control form-control-sm" rows="3"
                                  placeholder="Add a description..."
                                  @bind="editDescription"></textarea>
                    }
                </div>

                @* Issue identity comes only from a verified durable link row (#336); mutable task
                   text is never an issue-identity fallback. PRs remain scoped to the exact legacy
                   sync block until #237 gives them a structured identity. *@
                @if (EditMode == EditItemType.Task)
                {
                    <GitHubIssueBadge Links="InitialExternalLinks"
                                      Description="@editDescription"
                                      CssClass="btn btn-sm btn-outline-secondary mb-3 me-2"
                                      TestId="edit-item-github-link" />
                    @if (gitHubPullRequest is not null)
                    {
                        <a class="btn btn-sm btn-outline-primary mb-3"
                           href="@gitHubPullRequest.Url"
                           target="_blank" rel="noopener noreferrer"
                           data-testid="edit-item-github-pr-link"
                           aria-label="@($"Open GitHub pull request #{gitHubPullRequest.Number} for {gitHubPullRequest.RepositoryOwner}/{gitHubPullRequest.RepositoryName} in a new tab")">
                            PR #@gitHubPullRequest.Number <span aria-hidden="true">↗</span>
                        </a>
                    }
                }

                @* Project-only fields *@
                @if (EditMode == EditItemType.Project)
                {
                    <div class="mb-3">
                        <label class="form-label small text-muted mb-1" for="edit-item-goals">Goals</label>
                        <textarea id="edit-item-goals" class="form-control form-control-sm" rows="3"
                                  placeholder="Project goals (markdown)..."
                                  @bind="editGoals"></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small text-muted mb-1" for="edit-item-readme">README</label>
                        <textarea id="edit-item-readme" class="form-control form-control-sm" rows="8"
                                  placeholder="Project documentation (markdown)..."
                                  @bind="editReadme" style="font-family: monospace; font-size: 0.85rem;"></textarea>
                    </div>
                }

                @* Feature-only fields *@
                @if (EditMode == EditItemType.Feature)
                {
                    <div class="mb-3">
                        <label class="form-label small text-muted mb-1" for="edit-item-parent-feature">Parent Feature</label>
                        <select id="edit-item-parent-feature" class="form-select form-select-sm" @bind="editParentFeatureId">
                            <option value="0">None (top-level)</option>
                            @if (AllFeatures is not null)
                            {
                                @foreach (var f in AllFeatures.Where(CanUseAsParentFeature).OrderBy(f => f.SortOrder))
                                {
                                    var prefix = f.ParentFeatureId.HasValue ? "  " : "";
                                    <option value="@f.Id">@prefix@f.Name</option>
                                }
                            }
                        </select>
                    </div>
                }

                @* Task-only fields *@
                @if (EditMode == EditItemType.Task)
                {
                    <div class="mb-3">
                        <label class="form-label small text-muted mb-1" for="edit-item-feature">Feature</label>
                        <select id="edit-item-feature" class="form-select form-select-sm" @bind="editFeatureId">
                            @if (AllFeatures is not null)
                            {
                                @foreach (var f in AllFeatures.OrderBy(f => f.SortOrder))
                                {
                                    var prefix = f.ParentFeatureId.HasValue ? "  " : "";
                                    <option value="@f.Id">@prefix@f.Name</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6">
                            <label class="form-label small text-muted mb-1" for="edit-item-status">Status</label>
                            <select id="edit-item-status" class="form-select form-select-sm" @bind="editStatus">
                                @foreach (var status in Enum.GetValues<WorkStatus>())
                                {
                                    <option value="@((int)status)">@GetStatusDisplayName(status)</option>
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small text-muted mb-1" for="edit-item-priority">Priority</label>
                            <select id="edit-item-priority" class="form-select form-select-sm" @bind="editPriority">
                                @foreach (var priority in Enum.GetValues<TaskPriority>())
                                {
                                    <option value="@((int)priority)">@priority</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small text-muted mb-1" for="edit-item-assignee">Assignee</label>
                        <input id="edit-item-assignee" type="text" class="form-control form-control-sm" placeholder="Unassigned" @bind="editAssignee" />
                    </div>

                    @* Subtasks as cards *@
                    @if (taskSubtasks.Count > 0)
                    {
                        <div class="mb-3">
                            <div id="edit-item-subtasks-label" class="form-label small text-muted mb-1">Subtasks</div>
                            @foreach (var sub in taskSubtasks.Where(s => s.ParentSubtaskId == null).OrderBy(s => s.SortOrder))
                            {
                                <div class="card mb-1" style="border-left: 3px solid @(sub.Completed ? "#198754" : "#6c757d"); @(sub.Completed ? "opacity: 0.6;" : "")">
                                    <div class="card-body p-2 d-flex align-items-center">
                                        <input id="@($"edit-item-subtask-{sub.Id}")" type="checkbox" class="form-check-input me-2 flex-shrink-0" style="margin-top: 0;"
                                               checked="@sub.Completed"
                                               @onchange="() => ToggleSubtaskInModal(sub)" />
                                        <label class="small @(sub.Completed ? "text-decoration-line-through text-muted" : "")" for="@($"edit-item-subtask-{sub.Id}")">@sub.Text</label>
                                    </div>
                                </div>
                                @* Nested subtasks *@
                                @foreach (var child in taskSubtasks.Where(s => s.ParentSubtaskId == sub.Id).OrderBy(s => s.SortOrder))
                                {
                                    <div class="card mb-1 ms-3" style="border-left: 3px solid @(child.Completed ? "#198754" : "#adb5bd"); @(child.Completed ? "opacity: 0.6;" : "")">
                                        <div class="card-body p-2 d-flex align-items-center">
                                            <input id="@($"edit-item-subtask-{child.Id}")" type="checkbox" class="form-check-input me-2 flex-shrink-0" style="margin-top: 0;"
                                                   checked="@child.Completed"
                                                   @onchange="() => ToggleSubtaskInModal(child)" />
                                            <label class="small @(child.Completed ? "text-decoration-line-through text-muted" : "")" for="@($"edit-item-subtask-{child.Id}")">@child.Text</label>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    }

                    @* Activity Timeline — the task's COMPLETE history (#328).
                       This block used to render `taskComments` ONLY, so every field-level change
                       (status, priority, assignment, rename) was recorded in ActivityEvent
                       server-side and invisible here. ActivityTimeline merges both records and
                       de-duplicates the pairs TaskService writes for a single action.

                       It is the SAME component TaskDetailPanel uses — deliberately, so the two
                       task surfaces cannot drift apart the way their timestamps did (#306).

                       The old per-comment markup below rendered `comment.CreatedAt` raw, i.e. in
                       UTC with no `.ToLocalTime()` and no tooltip — a THIRD clock alongside the
                       two #306 documents in TaskDetailPanel. The timeline renders local time with
                       the absolute UTC on hover, uniformly. *@
                    <div class="mb-3">
                        <div id="edit-item-activity-label" class="form-label small text-muted mb-1">Activity</div>
                        @* This id labelled the comment list that the timeline replaced, and for a
                           while it labelled nothing at all — leaving a screen reader with an
                           unnamed scroll container holding the task's whole history. `tabindex="0"`
                           is deliberate, not a stray: `.kf-timeline-panel` sets `overflow-y: auto`,
                           and a scrollable region a keyboard cannot reach is a keyboard trap in
                           reverse — the content simply cannot be scrolled to. *@
                        <div class="border rounded p-2 kf-timeline-panel"
                             role="region" aria-labelledby="edit-item-activity-label" tabindex="0">
                            <ActivityTimeline TaskId="EditTaskId"
                                              Comments="taskComments"
                                              RefreshToken="activityRefreshToken" />
                        </div>

                        @* Add comment *@
                        <div class="input-group input-group-sm mt-2">
                            <input type="text" class="form-control" placeholder="Add a comment..." aria-label="Add activity comment"
                                   @bind="newCommentText" @bind:event="oninput"
                                   @onkeydown="HandleCommentKeyDown" />
                            <button class="btn btn-outline-primary" @onclick="AddComment"
                                    disabled="@string.IsNullOrWhiteSpace(newCommentText)">
                                Send
                            </button>
                        </div>
                    </div>
                }
            @if (IsOpen && EditMode != EditItemType.Task)
            {
                <details class="mx-3 mb-3" data-testid="edit-item-history">
                    <summary>History</summary>
                    <ActivityTimeline ProjectId="@(EditMode == EditItemType.Project ? EditProjectId : null)"
                                      EntityType="@(EditMode == EditItemType.Feature ? "Feature" : null)"
                                      EntityId="EditFeatureId" RefreshToken="activityRefreshToken" />
                </details>
            }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" @onclick="Close" data-testid="edit-item-cancel-button">Cancel</button>
                <button type="button" class="btn btn-primary btn-sm" @onclick="SaveChanges"
                        data-testid="edit-item-save-button"
                        disabled="@string.IsNullOrWhiteSpace(editName)">
                    Save Changes
                </button>
            </div>
        </div>
    </div>
</div>

@if (IsOpen)
{
    <div class="modal-backdrop fade show"></div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EditItemType EditMode { get; set; }
    [Parameter] public int EditProjectId { get; set; }
    [Parameter] public int? EditFeatureId { get; set; }
    [Parameter] public int? EditTaskId { get; set; }
    [Parameter] public int HistoryRefreshToken { get; set; }
    private int seenHistoryRefreshToken;
    [Parameter] public List<Feature>? AllFeatures { get; set; }

    // Pre-populated values
    [Parameter] public string? InitialName { get; set; }
    [Parameter] public string? InitialDescription { get; set; }
    [Parameter] public string? InitialGoals { get; set; }
    [Parameter] public string? InitialReadme { get; set; }
    [Parameter] public int? InitialParentFeatureId { get; set; }
    [Parameter] public int? InitialFeatureId { get; set; }
    [Parameter] public int? InitialStatus { get; set; }
    [Parameter] public int? InitialPriority { get; set; }
    [Parameter] public string? InitialAssignee { get; set; }
    [Parameter] public IReadOnlyList<ExternalWorkItemLink>? InitialExternalLinks { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private string? editName;
    private string? editDescription;
    private string? editGoals;
    private string? editReadme;

    // Bumped only on a fresh open / a switch to a different item, which is what returns
    // EditableMarkdown to read mode (#357). Never on an ordinary re-render: the field raises
    // ValueChanged per keystroke, so resetting on every OnParametersSet would eject the user
    // mid-word.
    private int descriptionResetToken;
    private GitHubPullRequestReference? gitHubPullRequest;

    private void RefreshGitHubPullRequest() =>
        gitHubPullRequest = ExternalWorkItemPresentation.FindSyncBlockPullRequest(editDescription);

    private int editParentFeatureId;
    private int editFeatureId;
    private int editStatus;
    private int editPriority;
    private string? editAssignee;
    private string? errorMessage;

    // Task subtasks + comments
    private List<Subtask> taskSubtasks = [];
    private List<TaskComment> taskComments = [];
    private string? newCommentText;

    // Bumped whenever an action may have written new ActivityEvents, so ActivityTimeline re-reads
    // the audit trail. Comments flow through the Comments parameter and need no token.
    private int activityRefreshToken;
    private bool wasOpen;
    private int? lastOpenedTaskId;

    protected override void OnParametersSet()
    {
        if (HistoryRefreshToken != seenHistoryRefreshToken)
        {
            seenHistoryRefreshToken = HistoryRefreshToken;
            activityRefreshToken++;
        }
        // A FRESH OPEN, or a switch to a different task — not merely "the parent re-rendered".
        //
        // Everything below discards state and re-reads from the server, so running it on every
        // parent render was wrong twice over: it threw away whatever the user had typed into the
        // form, and it emptied `taskComments` mid-session. That second one became visible when the
        // timeline started merging events: with an empty Comments list there is nothing for a
        // `TaskCommentAdded` event to pair with, so the history rendered every comment TWICE until
        // the async reload landed. The refresh-token bump below was already correctly guarded on
        // this condition — the state reset simply was not.
        if (IsOpen && (!wasOpen || EditTaskId != lastOpenedTaskId))
        {
            editName = InitialName;
            editDescription = InitialDescription;
            editGoals = InitialGoals;
            editReadme = InitialReadme;
            editParentFeatureId = InitialParentFeatureId ?? 0;
            editFeatureId = InitialFeatureId ?? 0;
            editStatus = InitialStatus ?? 0;
            editPriority = InitialPriority ?? 0;
            editAssignee = InitialAssignee;
            errorMessage = null;
            newCommentText = null;
            taskSubtasks = [];
            taskComments = [];
            descriptionResetToken++;   // a fresh open never lands in description edit mode (#357)
            RefreshGitHubPullRequest();
            // ActivityTimeline only re-queries on a TaskId change, and closing then reopening the
            // SAME task does not change it — so a reopen has to say so explicitly.
            activityRefreshToken++;
            lastOpenedTaskId = EditTaskId;

            if (EditMode == EditItemType.Task && EditTaskId.HasValue)
            {
                _ = LoadTaskDetails();
            }
        }

        wasOpen = IsOpen;
    }

    private bool CanUseAsParentFeature(Feature feature)
    {
        if (EditFeatureId is not int editFeatureId)
            return true;

        return feature.Id != editFeatureId && !WouldCreateFeatureCycle(editFeatureId, feature.Id);
    }

    private bool WouldCreateFeatureCycle(int featureId, int proposedParentFeatureId)
    {
        if (featureId == proposedParentFeatureId)
            return true;

        if (AllFeatures is null)
            return false;

        var visited = new HashSet<int>();
        var currentParentId = proposedParentFeatureId;

        while (visited.Add(currentParentId))
        {
            if (currentParentId == featureId)
                return true;

            var current = AllFeatures.FirstOrDefault(f => f.Id == currentParentId);
            if (current?.ParentFeatureId is not int nextParentId)
                return false;

            currentParentId = nextParentId;
        }

        return false;
    }

    private async Task LoadTaskDetails()
    {
        if (EditTaskId is null) return;
        using var db = await DbFactory.CreateDbContextAsync();
        taskSubtasks = await db.Subtasks
            .Where(s => s.TaskItemId == EditTaskId.Value)
            .AsNoTracking()
            .OrderBy(s => s.SortOrder)
            .ToListAsync();
        taskComments = await db.TaskComments
            .Where(c => c.TaskItemId == EditTaskId.Value)
            .AsNoTracking()
            .OrderBy(c => c.CreatedAt)
            .ToListAsync();
        StateHasChanged();
    }

    private async Task ToggleSubtaskInModal(Subtask subtask)
    {
        subtask.Completed = !subtask.Completed;
        using var db = await DbFactory.CreateDbContextAsync();
        db.Subtasks.Attach(subtask);
        db.Entry(subtask).Property(s => s.Completed).IsModified = true;
        await db.SaveChangesWithAuditAsync("User");
        activityRefreshToken++;
        await OnSaved.InvokeAsync();
    }

    private async Task HandleCommentKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(newCommentText))
            await AddComment();
    }

    private async Task AddComment()
    {
        if (EditTaskId is null || string.IsNullOrWhiteSpace(newCommentText)) return;
        // Route the comment through ITaskService so the UI emits a TaskCommentAdded
        // audit event identical to the REST/MCP surfaces (#88).
        var comment = await TaskService.AddCommentAsync(
            EditTaskId.Value, newCommentText, author: "User", type: CommentType.Comment, actor: "User");
        taskComments.Add(comment);
        // AddCommentAsync also writes a paired TaskCommentAdded ActivityEvent; re-read so the
        // timeline can de-duplicate the pair instead of showing the comment twice on next open.
        activityRefreshToken++;
        newCommentText = null;
        StateHasChanged();
    }

    private async Task HandleBackdropClick() => await Close();

    private async Task Close() => await OnClose.InvokeAsync();

    // ── Accessible dialog (#166): focus-trap + Esc + focus restore via KanbanFlow.initDialog ──
    private ElementReference dialogRef;
    private DotNetObjectReference<EditItemModal>? _selfRef;
    private bool _dialogInited;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsOpen && !_dialogInited)
        {
            _dialogInited = true;   // set before the await so a re-render mid-init can't double-call
            _selfRef ??= DotNetObjectReference.Create(this);
            try { await JS.InvokeVoidAsync("KanbanFlow.initDialog", dialogRef, _selfRef); }
            catch (Microsoft.JSInterop.JSDisconnectedException) { /* circuit gone during teardown */ }
        }
        else if (!IsOpen && _dialogInited)
        {
            _dialogInited = false;
            await SafeDestroyDialogAsync();
        }
    }

    [JSInvokable]
    public Task CloseFromJs() => Close();

    private async Task SafeDestroyDialogAsync()
    {
        try { await JS.InvokeVoidAsync("KanbanFlow.destroyDialog", dialogRef); }
        catch (Microsoft.JSInterop.JSDisconnectedException) { /* circuit gone during teardown */ }
    }

    public async ValueTask DisposeAsync()
    {
        if (_dialogInited)
            await SafeDestroyDialogAsync();
        _selfRef?.Dispose();
    }

    private string GetItemTypeName() => EditMode switch
    {
        EditItemType.Project => "Project",
        EditItemType.Feature => "Feature",
        EditItemType.Task => "Task",
        _ => "Item"
    };

    private async Task SaveChanges()
    {
        if (string.IsNullOrWhiteSpace(editName)) return;
        errorMessage = null;

        try
        {
            using var db = await DbFactory.CreateDbContextAsync();

            switch (EditMode)
            {
                case EditItemType.Project:
                    var project = await db.Projects.FindAsync(EditProjectId);
                    if (project is null) { errorMessage = "Project not found."; return; }
                    project.Name = editName.Trim();
                    project.Description = string.IsNullOrWhiteSpace(editDescription) ? null : editDescription.Trim();
                    project.Goals = string.IsNullOrWhiteSpace(editGoals) ? null : editGoals.Trim();
                    project.Readme = string.IsNullOrWhiteSpace(editReadme) ? null : editReadme.Trim();
                    project.UpdatedAt = DateTime.UtcNow;
                    break;

                case EditItemType.Feature:
                    if (EditFeatureId is null) return;
                    var feature = await db.Features.FindAsync(EditFeatureId.Value);
                    if (feature is null) { errorMessage = "Feature not found."; return; }
                    if (editParentFeatureId != 0 && WouldCreateFeatureCycle(EditFeatureId.Value, editParentFeatureId))
                    {
                        errorMessage = "A feature cannot be moved under itself or one of its descendants.";
                        return;
                    }

                    feature.Name = editName.Trim();
                    feature.Description = string.IsNullOrWhiteSpace(editDescription) ? null : editDescription.Trim();
                    feature.ParentFeatureId = editParentFeatureId == 0 ? null : editParentFeatureId;
                    feature.UpdatedAt = DateTime.UtcNow;
                    break;

                case EditItemType.Task:
                    if (EditTaskId is null) return;
                    // Route the task edit through ITaskService so every field change emits
                    // the same TaskUpdated / TaskStatusChanged audit events (and StatusChange
                    // comment) as the REST/MCP surfaces — instead of a silent SaveChanges
                    // bypass (#88). UpdateAsync handles the CompletedAt invariant internally.
                    await TaskService.UpdateAsync(EditTaskId.Value, new TaskUpdate(
                        Name: editName,
                        Description: editDescription,
                        Status: (WorkStatus)editStatus,
                        Priority: (TaskPriority)editPriority,
                        Assignee: editAssignee), actor: "User");
                    // Feature moves are a separate audit concern (TaskFeatureChanged) with a
                    // cross-project guard; no-op when the feature is unchanged.
                    await TaskService.ReassignToFeatureAsync(EditTaskId.Value, editFeatureId, actor: "User");
                    break;
            }

            // The Task path mutates through ITaskService (its own DbContext) and has
            // already persisted; the outer save would be a no-op that muddies the
            // unit-of-work, so skip it. Project/Feature edits mutate the outer `db`
            // above and still need this save.
            if (EditMode != EditItemType.Task)
                await db.SaveChangesWithAuditAsync("User");

            await OnSaved.InvokeAsync();
            await OnClose.InvokeAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private static string GetStatusDisplayName(WorkStatus status) => status switch
    {
        WorkStatus.Backlog => "Backlog",
        WorkStatus.Todo => "To Do",
        WorkStatus.InProgress => "In Progress",
        WorkStatus.Review => "Review",
        WorkStatus.Done => "Done",
        _ => status.ToString()
    };
}
