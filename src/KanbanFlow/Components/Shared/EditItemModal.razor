@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory

@* Bootstrap Modal for editing Projects, Features, and Tasks *@
<div class="modal fade @(IsOpen ? "show" : "")" tabindex="-1" data-testid="edit-item-modal"
     style="display: @(IsOpen ? "block" : "none");"
     @onclick="HandleBackdropClick" @onclick:stopPropagation="false">
    <div class="modal-dialog modal-lg modal-dialog-scrollable" @onclick:stopPropagation="true">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit @GetItemTypeName()</h5>
                <button type="button" class="btn-close" @onclick="Close" aria-label="Close edit item modal" data-testid="edit-item-close-button"></button>
            </div>
            <div class="modal-body">
                @if (errorMessage is not null)
                {
                    <div class="alert alert-danger alert-dismissible fade show py-2 small" role="alert">
                        @errorMessage
                        <button type="button" class="btn-close btn-close-sm" @onclick="() => errorMessage = null"></button>
                    </div>
                }

                @* Name *@
                <div class="mb-3">
                    <label class="form-label small text-muted mb-1">Name</label>
                    <input type="text" class="form-control" @bind="editName" @bind:event="oninput" />
                </div>

                @* Description *@
                <div class="mb-3">
                    <label class="form-label small text-muted mb-1">Description</label>
                    <textarea class="form-control form-control-sm" rows="3"
                              placeholder="Add a description..."
                              @bind="editDescription"></textarea>
                </div>

                @* Project-only fields *@
                @if (EditMode == EditItemType.Project)
                {
                    <div class="mb-3">
                        <label class="form-label small text-muted mb-1">Goals</label>
                        <textarea class="form-control form-control-sm" rows="3"
                                  placeholder="Project goals (markdown)..."
                                  @bind="editGoals"></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small text-muted mb-1">README</label>
                        <textarea class="form-control form-control-sm" rows="8"
                                  placeholder="Project documentation (markdown)..."
                                  @bind="editReadme" style="font-family: monospace; font-size: 0.85rem;"></textarea>
                    </div>
                }

                @* Feature-only fields *@
                @if (EditMode == EditItemType.Feature)
                {
                    <div class="mb-3">
                        <label class="form-label small text-muted mb-1">Parent Feature</label>
                        <select class="form-select form-select-sm" @bind="editParentFeatureId">
                            <option value="0">None (top-level)</option>
                            @if (AllFeatures is not null)
                            {
                                @foreach (var f in AllFeatures.Where(f => f.Id != EditFeatureId).OrderBy(f => f.SortOrder))
                                {
                                    var prefix = f.ParentFeatureId.HasValue ? "  " : "";
                                    <option value="@f.Id">@prefix@f.Name</option>
                                }
                            }
                        </select>
                    </div>
                }

                @* Task-only fields *@
                @if (EditMode == EditItemType.Task)
                {
                    <div class="mb-3">
                        <label class="form-label small text-muted mb-1">Feature</label>
                        <select class="form-select form-select-sm" @bind="editFeatureId">
                            @if (AllFeatures is not null)
                            {
                                @foreach (var f in AllFeatures.OrderBy(f => f.SortOrder))
                                {
                                    var prefix = f.ParentFeatureId.HasValue ? "  " : "";
                                    <option value="@f.Id">@prefix@f.Name</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6">
                            <label class="form-label small text-muted mb-1">Status</label>
                            <select class="form-select form-select-sm" @bind="editStatus">
                                @foreach (var status in Enum.GetValues<WorkStatus>())
                                {
                                    <option value="@((int)status)">@GetStatusDisplayName(status)</option>
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small text-muted mb-1">Priority</label>
                            <select class="form-select form-select-sm" @bind="editPriority">
                                @foreach (var priority in Enum.GetValues<TaskPriority>())
                                {
                                    <option value="@((int)priority)">@priority</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small text-muted mb-1">Assignee</label>
                        <input type="text" class="form-control form-control-sm" placeholder="Unassigned" @bind="editAssignee" />
                    </div>

                    @* Subtasks as cards *@
                    @if (taskSubtasks.Count > 0)
                    {
                        <div class="mb-3">
                            <label class="form-label small text-muted mb-1">Subtasks</label>
                            @foreach (var sub in taskSubtasks.Where(s => s.ParentSubtaskId == null).OrderBy(s => s.SortOrder))
                            {
                                <div class="card mb-1" style="border-left: 3px solid @(sub.Completed ? "#198754" : "#6c757d"); @(sub.Completed ? "opacity: 0.6;" : "")">
                                    <div class="card-body p-2 d-flex align-items-center">
                                        <input type="checkbox" class="form-check-input me-2 flex-shrink-0" style="margin-top: 0;"
                                               checked="@sub.Completed"
                                               @onchange="() => ToggleSubtaskInModal(sub)" />
                                        <span class="small @(sub.Completed ? "text-decoration-line-through text-muted" : "")">@sub.Text</span>
                                    </div>
                                </div>
                                @* Nested subtasks *@
                                @foreach (var child in taskSubtasks.Where(s => s.ParentSubtaskId == sub.Id).OrderBy(s => s.SortOrder))
                                {
                                    <div class="card mb-1 ms-3" style="border-left: 3px solid @(child.Completed ? "#198754" : "#adb5bd"); @(child.Completed ? "opacity: 0.6;" : "")">
                                        <div class="card-body p-2 d-flex align-items-center">
                                            <input type="checkbox" class="form-check-input me-2 flex-shrink-0" style="margin-top: 0;"
                                                   checked="@child.Completed"
                                                   @onchange="() => ToggleSubtaskInModal(child)" />
                                            <span class="small @(child.Completed ? "text-decoration-line-through text-muted" : "")">@child.Text</span>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    }

                    @* Activity Timeline *@
                    <div class="mb-3">
                        <label class="form-label small text-muted mb-1">Activity</label>
                        <div class="border rounded p-2" style="max-height: 250px; overflow-y: auto; background: #f8f9fa;">
                            @if (taskComments.Count == 0)
                            {
                                <small class="text-muted">No activity yet.</small>
                            }
                            @foreach (var comment in taskComments.OrderByDescending(c => c.CreatedAt))
                            {
                                <div class="mb-2 pb-2 @(comment != taskComments.OrderByDescending(c => c.CreatedAt).Last() ? "border-bottom" : "")">
                                    <div class="d-flex align-items-center mb-1">
                                        @if (comment.Type == CommentType.Comment)
                                        {
                                            <span class="badge bg-primary me-2" style="font-size: 0.6rem;">Comment</span>
                                        }
                                        else if (comment.Type == CommentType.StatusChange)
                                        {
                                            <span class="badge bg-warning text-dark me-2" style="font-size: 0.6rem;">Status</span>
                                        }
                                        else if (comment.Type == CommentType.Created)
                                        {
                                            <span class="badge bg-success me-2" style="font-size: 0.6rem;">Created</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary me-2" style="font-size: 0.6rem;">@comment.Type</span>
                                        }
                                        <small class="text-muted fw-medium">@(comment.Author ?? "System")</small>
                                        <small class="text-muted ms-auto" style="font-size: 0.65rem;">@comment.CreatedAt.ToString("MMM d, h:mm tt")</small>
                                    </div>
                                    <small>@comment.Text</small>
                                </div>
                            }
                        </div>

                        @* Add comment *@
                        <div class="input-group input-group-sm mt-2">
                            <input type="text" class="form-control" placeholder="Add a comment..."
                                   @bind="newCommentText" @bind:event="oninput"
                                   @onkeydown="HandleCommentKeyDown" />
                            <button class="btn btn-outline-primary" @onclick="AddComment"
                                    disabled="@string.IsNullOrWhiteSpace(newCommentText)">
                                Send
                            </button>
                        </div>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" @onclick="Close" data-testid="edit-item-cancel-button">Cancel</button>
                <button type="button" class="btn btn-primary btn-sm" @onclick="SaveChanges"
                        data-testid="edit-item-save-button"
                        disabled="@string.IsNullOrWhiteSpace(editName)">
                    Save Changes
                </button>
            </div>
        </div>
    </div>
</div>

@if (IsOpen)
{
    <div class="modal-backdrop fade show"></div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EditItemType EditMode { get; set; }
    [Parameter] public int EditProjectId { get; set; }
    [Parameter] public int? EditFeatureId { get; set; }
    [Parameter] public int? EditTaskId { get; set; }
    [Parameter] public List<Feature>? AllFeatures { get; set; }

    // Pre-populated values
    [Parameter] public string? InitialName { get; set; }
    [Parameter] public string? InitialDescription { get; set; }
    [Parameter] public string? InitialGoals { get; set; }
    [Parameter] public string? InitialReadme { get; set; }
    [Parameter] public int? InitialParentFeatureId { get; set; }
    [Parameter] public int? InitialFeatureId { get; set; }
    [Parameter] public int? InitialStatus { get; set; }
    [Parameter] public int? InitialPriority { get; set; }
    [Parameter] public string? InitialAssignee { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private string? editName;
    private string? editDescription;
    private string? editGoals;
    private string? editReadme;
    private int editParentFeatureId;
    private int editFeatureId;
    private int editStatus;
    private int editPriority;
    private string? editAssignee;
    private string? errorMessage;

    // Task subtasks + comments
    private List<Subtask> taskSubtasks = [];
    private List<TaskComment> taskComments = [];
    private string? newCommentText;

    protected override void OnParametersSet()
    {
        if (IsOpen)
        {
            editName = InitialName;
            editDescription = InitialDescription;
            editGoals = InitialGoals;
            editReadme = InitialReadme;
            editParentFeatureId = InitialParentFeatureId ?? 0;
            editFeatureId = InitialFeatureId ?? 0;
            editStatus = InitialStatus ?? 0;
            editPriority = InitialPriority ?? 0;
            editAssignee = InitialAssignee;
            errorMessage = null;
            newCommentText = null;
            taskSubtasks = [];
            taskComments = [];

            if (EditMode == EditItemType.Task && EditTaskId.HasValue)
            {
                _ = LoadTaskDetails();
            }
        }
    }

    private async Task LoadTaskDetails()
    {
        if (EditTaskId is null) return;
        using var db = await DbFactory.CreateDbContextAsync();
        taskSubtasks = await db.Subtasks
            .Where(s => s.TaskItemId == EditTaskId.Value)
            .AsNoTracking()
            .OrderBy(s => s.SortOrder)
            .ToListAsync();
        taskComments = await db.TaskComments
            .Where(c => c.TaskItemId == EditTaskId.Value)
            .AsNoTracking()
            .OrderBy(c => c.CreatedAt)
            .ToListAsync();
        StateHasChanged();
    }

    private async Task ToggleSubtaskInModal(Subtask subtask)
    {
        subtask.Completed = !subtask.Completed;
        using var db = await DbFactory.CreateDbContextAsync();
        db.Subtasks.Attach(subtask);
        db.Entry(subtask).Property(s => s.Completed).IsModified = true;
        await db.SaveChangesAsync();
        await OnSaved.InvokeAsync();
    }

    private async Task HandleCommentKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(newCommentText))
            await AddComment();
    }

    private async Task AddComment()
    {
        if (EditTaskId is null || string.IsNullOrWhiteSpace(newCommentText)) return;
        using var db = await DbFactory.CreateDbContextAsync();
        var comment = new TaskComment
        {
            TaskItemId = EditTaskId.Value,
            Text = newCommentText.Trim(),
            Author = "User",
            Type = CommentType.Comment
        };
        db.TaskComments.Add(comment);
        await db.SaveChangesAsync();
        taskComments.Add(comment);
        newCommentText = null;
        StateHasChanged();
    }

    private async Task HandleBackdropClick() => await Close();

    private async Task Close() => await OnClose.InvokeAsync();

    private string GetItemTypeName() => EditMode switch
    {
        EditItemType.Project => "Project",
        EditItemType.Feature => "Feature",
        EditItemType.Task => "Task",
        _ => "Item"
    };

    private async Task SaveChanges()
    {
        if (string.IsNullOrWhiteSpace(editName)) return;
        errorMessage = null;

        try
        {
            using var db = await DbFactory.CreateDbContextAsync();

            switch (EditMode)
            {
                case EditItemType.Project:
                    var project = await db.Projects.FindAsync(EditProjectId);
                    if (project is null) { errorMessage = "Project not found."; return; }
                    project.Name = editName.Trim();
                    project.Description = string.IsNullOrWhiteSpace(editDescription) ? null : editDescription.Trim();
                    project.Goals = string.IsNullOrWhiteSpace(editGoals) ? null : editGoals.Trim();
                    project.Readme = string.IsNullOrWhiteSpace(editReadme) ? null : editReadme.Trim();
                    project.UpdatedAt = DateTime.UtcNow;
                    break;

                case EditItemType.Feature:
                    if (EditFeatureId is null) return;
                    var feature = await db.Features.FindAsync(EditFeatureId.Value);
                    if (feature is null) { errorMessage = "Feature not found."; return; }
                    feature.Name = editName.Trim();
                    feature.Description = string.IsNullOrWhiteSpace(editDescription) ? null : editDescription.Trim();
                    feature.ParentFeatureId = editParentFeatureId == 0 ? null : editParentFeatureId;
                    feature.UpdatedAt = DateTime.UtcNow;
                    break;

                case EditItemType.Task:
                    if (EditTaskId is null) return;
                    var task = await db.Tasks.FindAsync(EditTaskId.Value);
                    if (task is null) { errorMessage = "Task not found."; return; }
                    var oldStatus = task.Status;
                    var newStatus = (WorkStatus)editStatus;
                    task.Name = editName.Trim();
                    task.Description = string.IsNullOrWhiteSpace(editDescription) ? null : editDescription.Trim();
                    task.FeatureId = editFeatureId;
                    task.Status = newStatus;
                    task.Priority = (TaskPriority)editPriority;
                    task.Assignee = string.IsNullOrWhiteSpace(editAssignee) ? null : editAssignee.Trim();
                    task.UpdatedAt = DateTime.UtcNow;
                    if (newStatus == WorkStatus.Done && oldStatus != WorkStatus.Done)
                        task.CompletedAt = DateTime.UtcNow;
                    else if (newStatus != WorkStatus.Done)
                        task.CompletedAt = null;
                    break;
            }

            await db.SaveChangesAsync();
            await OnSaved.InvokeAsync();
            await OnClose.InvokeAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private static string GetStatusDisplayName(WorkStatus status) => status switch
    {
        WorkStatus.Backlog => "Backlog",
        WorkStatus.Todo => "To Do",
        WorkStatus.InProgress => "In Progress",
        WorkStatus.Review => "Review",
        WorkStatus.Done => "Done",
        _ => status.ToString()
    };
}
