<div class="kanban-board flex-grow-1 d-flex overflow-auto p-2 gap-2" data-testid="kanban-board">
    @foreach (var status in Enum.GetValues<WorkStatus>())
    {
        var tasksInColumn = AllTasks.Where(t => t.Status == status).ToList();
        <KanbanColumn Status="status"
                      Tasks="tasksInColumn"
                      OnAddTask="OnAddTask"
                      OnToggleTaskDone="OnToggleTaskDone"
                      OnOpenTaskDetail="OnOpenTaskDetail" />
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<TaskItem> AllTasks { get; set; } = [];
    [Parameter] public EventCallback<WorkStatus> OnAddTask { get; set; }
    [Parameter] public EventCallback<TaskItem> OnToggleTaskDone { get; set; }
    [Parameter] public EventCallback<TaskItem> OnOpenTaskDetail { get; set; }
}
