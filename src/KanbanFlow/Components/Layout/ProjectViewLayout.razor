@inherits LayoutComponentBase
@implements IDisposable
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav

<a class="project-skip-link visually-hidden-focusable" href="@BoardSearchHref" data-enhance-nav="false"
   data-project-skip-target="board-filter-search" data-testid="skip-to-board-search">Skip to board search</a>
<a class="project-skip-link visually-hidden-focusable" href="@BoardCardsHref" data-enhance-nav="false"
   data-project-skip-target="kanban-board-heading" data-testid="skip-to-board-cards">Skip to board cards</a>

<NavMenu ProjectName="@projectName" />

<main id="project-content" tabindex="-1" aria-label="Project workspace">
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">&#x1F5D9;</span>
</div>

@code {
    private string? projectName;
    private string BoardSearchHref => Nav.Uri.Split('#')[0] + "#board-filter-search";
    private string BoardCardsHref => Nav.Uri.Split('#')[0] + "#kanban-board-heading";

    private int loadGeneration;
    private bool disposed;

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        await LoadProjectNameAsync(Nav.Uri);
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (!disposed) _ = InvokeAsync(() => LoadProjectNameAsync(e.Location));
    }

    private async Task LoadProjectNameAsync(string uri)
    {
        var generation = ++loadGeneration;
        var relativePath = Nav.ToBaseRelativePath(uri).Split('?', '#')[0];
        projectName = null;
        if (!relativePath.StartsWith("project/", StringComparison.OrdinalIgnoreCase)
            || !int.TryParse(relativePath["project/".Length..], out var id))
        {
            if (!disposed) StateHasChanged();
            return;
        }
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var name = await db.Projects.AsNoTracking()
                .Where(p => p.Id == id)
                .Select(p => p.Name)
                .FirstOrDefaultAsync();
            if (disposed || generation != loadGeneration || Nav.Uri != uri) return;
            projectName = name;
            StateHasChanged();
        }
        catch
        {
            // Breadcrumb is non-critical; the project page owns load errors.
        }
    }

    public void Dispose()
    {
        disposed = true;
        ++loadGeneration;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
