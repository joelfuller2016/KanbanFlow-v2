@inherits LayoutComponentBase
@implements IDisposable
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav

<a class="project-skip-link visually-hidden-focusable" href="@ProjectContentHref" data-enhance-nav="false"
   data-project-skip-target="board-filter-search" data-testid="skip-to-board-search">Skip to board search</a>
<a class="project-skip-link visually-hidden-focusable" href="@ProjectContentHref" data-enhance-nav="false"
   data-project-skip-target="kanban-board-heading" data-testid="skip-to-board-cards">Skip to board cards</a>

<NavMenu ProjectName="@projectName" />

<main id="project-content" tabindex="-1" aria-label="Project workspace">
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">&#x1F5D9;</span>
</div>

@code {
    private string? projectName;
    private string ProjectContentHref => Nav.Uri.Split('#')[0] + "#project-content";

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        LoadProjectName(Nav.Uri);
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        LoadProjectName(e.Location);
    }

    private void LoadProjectName(string uri)
    {
        var relativePath = Nav.ToBaseRelativePath(uri);
        if (relativePath.StartsWith("project/", StringComparison.OrdinalIgnoreCase))
        {
            var idPart = relativePath["project/".Length..];
            if (int.TryParse(idPart, out var id))
            {
                _ = LoadProjectNameAsync(id);
            }
        }
    }

    private async Task LoadProjectNameAsync(int id)
    {
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var name = await db.Projects
                .Where(p => p.Id == id)
                .Select(p => p.Name)
                .FirstOrDefaultAsync();
            projectName = name;
            StateHasChanged();
        }
        catch
        {
            // Silently fail - breadcrumb is non-critical
        }
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
