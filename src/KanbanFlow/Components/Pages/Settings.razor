@page "/settings"
@rendermode InteractiveServer
@inject ITestRunnerService TestRunner
@inject IAppStartupInfo Startup
@* #354: the resolution Program.cs actually opened the database with — not a second copy of the
   rule. Re-deriving it here is how the page and the boot log drifted apart in the first place. *@
@inject DbPathResolution DbResolution

<PageTitle>Settings - KanbanFlow</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Settings</h1>
</div>

<div class="row g-4">
    <div class="col-12 col-lg-4">
        <div class="card" data-testid="settings-app-info">
            <div class="card-header"><strong>App info</strong></div>
            <div class="card-body small">
                <dl class="row mb-0">
                    <dt class="col-5 text-muted">App</dt>
                    <dd class="col-7">@AppName <span class="text-muted">v@(AppVersion)</span></dd>

                    <dt class="col-5 text-muted">Runtime</dt>
                    <dd class="col-7">.NET @Environment.Version</dd>

                    <dt class="col-5 text-muted">Environment</dt>
                    <dd class="col-7">@HostEnv</dd>

                    <dt class="col-5 text-muted">Machine</dt>
                    <dd class="col-7 text-truncate" title="@Environment.MachineName">@Environment.MachineName</dd>

                    <dt class="col-5 text-muted">DB path</dt>
                    <dd class="col-7 text-truncate font-monospace" title="@DbResolution.Path">@DbResolution.Path</dd>

                    <dt class="col-5 text-muted">DB source</dt>
                    <dd class="col-7">
                        <span class="badge bg-secondary">@DbResolution.Source</span>
                        @* Existed is captured at RESOLUTION time, before EnsureCreated() runs, so this
                           describes the resolution OUTCOME and claims nothing about the file's state
                           now. "created new" would be a claim that only holds while EnsureCreated
                           happens to run unconditionally before the first request; "will create new"
                           is already false by the time this page can render. Both Copilot and
                           CodeRabbit flagged the creation claim — this wording makes neither. *@
                        <span class="text-muted ms-1">@(DbResolution.Existed ? "opened existing" : "no existing file — new database")</span>
                    </dd>

                    @foreach (var shadowed in DbResolution.ShadowedPaths)
                    {
                        <dt class="col-5 text-warning">Not opened</dt>
                        <dd class="col-7 text-truncate font-monospace text-warning" title="@shadowed">@shadowed</dd>
                    }

                    <dt class="col-5 text-muted">Started</dt>
                    <dd class="col-7">@Startup.StartedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-8">
        <div class="card" data-testid="settings-tests">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Run Tests</strong>
                @if (latestSuite is not null)
                {
                    <span class="badge @(latestSuite.AllPassed ? "text-bg-success" : "text-bg-danger")">
                        @latestSuite.Passed / @latestSuite.Total passed
                        @if (latestSuite.Failed > 0)
                        {
                            <span> · @latestSuite.Failed failed</span>
                        }
                    </span>
                }
            </div>
            <div class="card-body">
                <p class="text-muted small">
                    Three suites verify the live app from inside it. API tests hit the REST surface
                    with isolated test data; UI tests render each Razor route via SSR;
                    Service tests invoke <code>ITaskService</code> directly to verify the audit-log
                    contract that closes issue #88.
                </p>

                <div class="d-flex flex-wrap gap-2 mb-3" data-testid="settings-test-buttons">
                    <button class="btn btn-outline-primary" @onclick="@(() => RunSuite("api"))" disabled="@isRunning">
                        Run API tests
                    </button>
                    <button class="btn btn-outline-primary" @onclick="@(() => RunSuite("ui"))" disabled="@isRunning">
                        Run UI tests
                    </button>
                    <button class="btn btn-outline-primary" @onclick="@(() => RunSuite("service"))" disabled="@isRunning">
                        Run Service tests
                    </button>
                    <button class="btn btn-primary ms-auto" @onclick="@(() => RunSuite("all"))" disabled="@isRunning">
                        @(isRunning ? "Running…" : "Run all")
                    </button>
                </div>

                @if (isRunning)
                {
                    <div class="d-flex align-items-center text-muted small mb-3" aria-live="polite" aria-busy="true">
                        <div class="spinner-border spinner-border-sm me-2" role="status">
                            <span class="visually-hidden">Loading…</span>
                        </div>
                        Running @currentSuite tests…
                    </div>
                }

                @if (latestSuite is not null)
                {
                    <div class="mb-2 small">
                        <span class="text-muted">Suite:</span> <strong>@latestSuite.Suite</strong>
                        <span class="text-muted ms-3">Total time:</span> <strong>@latestSuite.TotalDurationMs.ToString("F0") ms</strong>
                    </div>

                    <div class="table-responsive" data-testid="settings-test-results">
                        <table class="table table-sm align-middle mb-0">
                            <caption class="visually-hidden">Test results for the @latestSuite.Suite suite</caption>
                            <thead>
                                <tr>
                                    <th scope="col" style="width: 1.5rem;"><span class="visually-hidden">Status</span></th>
                                    <th scope="col">Test</th>
                                    <th scope="col" class="d-none d-md-table-cell" style="width: 8rem;">Category</th>
                                    <th scope="col" class="text-end" style="width: 5rem;">Time</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in latestSuite.Tests)
                                {
                                    <tr class="@(t.Passed ? "" : "table-danger")">
                                        <td>
                                            @if (t.Passed)
                                            {
                                                <span class="badge text-bg-success" aria-label="Passed" title="Passed">✓</span>
                                            }
                                            else
                                            {
                                                <span class="badge text-bg-danger" aria-label="Failed" title="Failed">✗</span>
                                            }
                                        </td>
                                        <td>
                                            <div>@t.Name</div>
                                            @if (!t.Passed && !string.IsNullOrEmpty(t.Error))
                                            {
                                                <div class="small text-danger font-monospace text-break mt-1">@t.Error</div>
                                            }
                                        </td>
                                        <td class="d-none d-md-table-cell">
                                            <span class="badge bg-secondary">@t.Category</span>
                                        </td>
                                        <td class="text-end small text-muted">@t.DurationMs.ToString("F0")&nbsp;ms</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else if (!isRunning)
                {
                    <div class="text-muted small">No results yet — pick a suite above.</div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private TestSuiteResult? latestSuite;
    private bool isRunning;
    private string currentSuite = "";

    private string AppName { get; set; } = "KanbanFlow";
    private string AppVersion { get; set; } = "—";
    private string HostEnv { get; set; } = "—";

    protected override void OnInitialized()
    {
        var asm = typeof(Settings).Assembly;
        AppVersion = asm.GetName().Version?.ToString() ?? "—";
        HostEnv = Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT") ?? "Production";
    }

    private async Task RunSuite(string suite)
    {
        if (isRunning) return;
        isRunning = true;
        currentSuite = suite;
        latestSuite = null;
        StateHasChanged();

        try
        {
            latestSuite = suite switch
            {
                "api" => await TestRunner.RunApiTestsAsync(),
                "ui" => await TestRunner.RunUiTestsAsync(),
                "service" => await TestRunner.RunServiceTestsAsync(),
                _ => await TestRunner.RunAllTestsAsync()
            };
        }
        catch (Exception ex)
        {
            // Test runner itself crashed — surface as a single failed result so the user sees something useful.
            latestSuite = new TestSuiteResult(
                Suite: $"{suite} (runner crashed)",
                Tests: new[] { new TestResult("Runner exception", "Runner", false, 0, $"{ex.GetType().Name}: {ex.Message}") },
                TotalDurationMs: 0);
        }
        finally
        {
            isRunning = false;
            StateHasChanged();
        }
    }
}
