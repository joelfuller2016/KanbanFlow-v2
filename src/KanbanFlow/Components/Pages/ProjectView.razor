    // Cycling depth colors: blue, teal, purple, orange, pink — then repeat
    private static readonly string[] DepthColors = ["#0d6efd", "#0dcaf0", "#6f42c1", "#fd7e14", "#d63384"];
    private static string GetDepthColor(int depth) => DepthColors[depth % DepthColors.Length];
