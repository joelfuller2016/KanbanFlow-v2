    private async Task ToggleTaskDone(TaskItem task)
    {
        // Clear the previous refusal on entry, exactly as OnCardMoved (:1072) and
        // OnTaskReordered (:1096) do. LoadProject clears only loadError, so without this a
        // successful toggle on task B leaves task A's refusal banner on screen — a stale message
        // about an unrelated task next to work that just succeeded.
        moveError = null;

        try
        {
            // Routed through ITaskService so the audit event + status-change comment
            // fire (issue #88). Service also cascades subtask completion.
            await TaskSvc.ToggleDoneAsync(task.Id, actor: "User", _cts.Token);

            await LoadProject();
            await ReinitializeSortables();
        }
        catch (OperationCanceledException) { }
        catch (TaskNotFoundException) { /* silently ignore — task vanished mid-action */ }
        catch (Exception ex)
        {
            // A refused toggle must NOT take the load channel: loadError replaces the entire page
            // with "Something went wrong" and a Back to Projects button, destroying the board over
            // a routine, recoverable refusal. Same reasoning as OnCardMoved below.
            moveError = ex.Message;

            // Reloading alone does NOT snap the checkbox back. It renders `checked="@IsDone"`
            // with @onchange, so an unchanged Status produces no DOM update and the browser keeps
            // the user's click — leaving a checked box, labelled "mark as done", on a task that is
            // not Done. Bumping the token re-keys the card so the element is rebuilt from truth.
            checkboxResetToken++;

            await LoadProject();
            await ReinitializeSortables();
        }
    }

