        RequirementPriority.P2 => "badge text-bg-secondary",
        _ => "badge text-bg-secondary"
    };

    private static string GetRequirementStatusBadgeClass(RequirementStatus status) => status switch
    {
        RequirementStatus.Open => "badge text-bg-primary",
        RequirementStatus.InProgress => "badge text-bg-info",
        RequirementStatus.Done => "badge text-bg-success",
        _ => "badge text-bg-secondary"
    };

    private static string GetRequirementStatusDisplayName(RequirementStatus status) => status switch
    {
        RequirementStatus.InProgress => "In Progress",
        _ => status.ToString()
    };

    private sealed class AiProjectContext
    {
        public AiProject Project { get; set; } = new();
        public AiContextSummary Summary { get; set; } = new();
        public List<AiContextTask> Tasks { get; set; } = [];
    }

    private sealed class AiProject
    {
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
    }

    private sealed class AiContextSummary
    {
        public int FeatureCount { get; set; }
        public int TaskCount { get; set; }
        public int RequirementCount { get; set; }
    }

    private sealed class AiContextTask
    {
        public string Name { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
        public string Priority { get; set; } = string.Empty;
        public string? ClaimedBy { get; set; }
    }

    private sealed class AiNextTasksResponse
    {
        public List<AiTaskRecommendation> Recommendations { get; set; } = [];
    }

    private sealed class AiTaskRecommendation
    {
        public int Rank { get; set; }
        public string Name { get; set; } = string.Empty;
        public string FeatureName { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
        public string Priority { get; set; } = string.Empty;
        public string Reason { get; set; } = string.Empty;
    }

}
