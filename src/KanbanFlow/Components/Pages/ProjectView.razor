    // ── Board filter (#112) ──

    /// <summary>
    /// Resolve <c>filteredTasks</c> from <c>allTasks</c> + <c>filter</c>. The ONLY writer of
    /// <c>filteredTasks</c>; every filter mutation goes through <see cref="UpdateFilter"/>, which
    /// calls this. Never call it from a render-path property (see the field comment).
    /// </summary>
    private void ApplyFilter() => filteredTasks = TaskFilter.Apply(allTasks, filter);

    /// <summary>
    /// The single mutation point: swap the state, re-narrow NOW, and push the new state to the URL
    /// after a short quiet period so a reload restores the exact view and the link is shareable (AC 3).
    /// </summary>
    /// <remarks>
    /// The split is deliberate, and in this order.
    ///
    /// The BOARD updates synchronously, so <c>filter</c> is never behind what the user has typed and
    /// the cards narrow as they type (AC 2). Debouncing the STATE instead would leave <c>filter</c>
    /// lagging the DOM for the length of the quiet period, which is the divergence that lets a render
    /// land carrying text the user has already moved past.
    ///
    /// This is NOT what keeps the text boxes safe, though — that is BoardFilterBar's job, and it does
    /// it by rendering them from LOCAL fields that typing never touches (see the warning at the top
    /// of that file: a re-rendered <c>value</c> attribute eats keystrokes on a Server circuit no
    /// matter which directive writes it).
    ///
    /// The URL write is debounced because it is the expensive half: NavigateTo notifies the Router,
    /// which re-renders the whole matched route — this page, the outline and every rendered card —
    /// on top of the re-render the filter change already caused. At one keystroke per URL write that
    /// is two full renders per character on a Server circuit. <see cref="UrlSyncDebounce"/> (250ms,
    /// matching Ideas.razor) also coalesces a burst of chip clicks into a single history write.
    /// </remarks>
    private void UpdateFilter(TaskFilterState next)
    {
        filter = next;
        ApplyFilter();
        _ = SyncFilterToUrlAsync();
    }

    private async Task SyncFilterToUrlAsync()
    {
        // One pending sync at a time: each keystroke cancels its predecessor, so only the last
        // state in a burst reaches the URL.
        urlSyncCts?.Cancel();
        urlSyncCts?.Dispose();
        urlSyncCts = new CancellationTokenSource();
        var token = urlSyncCts.Token;

        try
        {
            await Task.Delay(UrlSyncDebounce, token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        try
        {
            // The query string is rebuilt from `filter`, not edited in place — that is what makes
            // Clear able to remove all filters — then this route's task and request context
            // parameters are merged back on.
            //
            // That merge is not optional. `?task=` arrived with #281 (the Home card's "Next" chip
            // deep-links straight at a task), which is precisely the "if this route ever grows an
            // unrelated param" case the previous version of this comment reserved. Without it the
            // first keystroke in the filter box silently strips `task=` out of the address bar, so
            // reloading or sharing the link no longer opens the task it named — and because
            // DeepLinkTaskId is [SupplyParameterFromQuery], the value is gone from the component
            // too and cannot be put back. Preserve `request=` for the same reason: losing it
            // resets the request workspace and its unsaved drafts. Ints and GUIDs need no escaping.
            //
            // replace: true so typing five characters leaves ONE history entry, not five — otherwise
            // Back walks the user backwards through their own keystrokes instead of off the page.
            // forceLoad: false keeps the SignalR circuit alive; a forced load would tear the page
            // down and rebuild it, losing the board's collapse state and re-running the whole load.
            var query = filter.ToQuery();
            if (DeepLinkTaskId is int taskId)
            {
                query = query.Length == 0 ? $"?task={taskId}" : $"{query}&task={taskId}";
            }
            if (WorkflowRequestId is Guid requestId)
            {
                query = query.Length == 0 ? $"?request={requestId}" : $"{query}&request={requestId}";
            }

            Nav.NavigateTo($"/project/{Id}{query}", forceLoad: false, replace: true);
        }
        catch (ObjectDisposedException) { /* circuit torn down while the sync was pending */ }
        catch (InvalidOperationException) { /* ditto — renderer already disposed */ }
    }

    private void OnSearchChanged(string? value) => UpdateFilter(filter with { Search = value });

