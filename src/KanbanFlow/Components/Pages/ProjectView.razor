    private void OnPriorityToggled((TaskPriority Priority, bool Selected) change)
    {
        var next = filter.Priorities.ToList();
        if (change.Selected)
        {
            if (!next.Contains(change.Priority)) next.Add(change.Priority);
        }
        else
        {
            next.Remove(change.Priority);
        }

        UpdateFilter(filter with { Priorities = next });
    }

