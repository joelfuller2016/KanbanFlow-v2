        UpdateFilter(TaskFilterState.Empty);
    }

    // ── Drag-and-Drop Handlers ──

    [JSInvokable]
    public async Task OnCardMoved(int taskId, string newStatus, int beforeTaskId)
    {
        // Reject undefined enum values up-front (closes part of #89 for the UI).
        if (!Enum.TryParse<WorkStatus>(newStatus, out var status)
            || !Enum.IsDefined(typeof(WorkStatus), status))
        {
            return;
        }

        moveError = null;
        try
        {
            // One service call atomically applies status + identity-anchored ordering. The third
            // JS argument is a task id (0 = append), never an index into the rendered subset.
            await TaskSvc.MoveOnBoardAsync(taskId, status, Id, beforeTaskId, actor: "User", _cts.Token);
            await LoadProject();
            await ReinitializeSortables();
        }
        catch (OperationCanceledException) { }
        catch (TaskNotFoundException) { /* task vanished mid-drag — drop silently */ }
        catch (Exception ex)
        {
            // A refused move must NOT take the load channel: loadError replaces the entire page.
            // Reload so the card snaps back to its persisted position.
            moveError = ex.Message;
            await LoadProject();
            await ReinitializeSortables();
        }
    }

    [JSInvokable]
    public async Task OnTaskReordered(int taskId, int newFeatureId, int beforeTaskId)
    {
        moveError = null;
        try
        {
            await TaskSvc.MoveInOutlineAsync(
                taskId, newFeatureId, beforeTaskId, actor: "User", _cts.Token);
            await LoadProject();
            await ReinitializeSortables();
        }
        catch (OperationCanceledException) { }
        catch (TaskNotFoundException) { /* task vanished mid-drag — drop silently */ }
        catch (Exception ex)
        {
            moveError = ex.Message;
            await LoadProject();
            await ReinitializeSortables();
        }
    }

    private async Task ReinitializeSortables()
    {
        StateHasChanged();
        await Task.Yield();
        if (dotNetRef is not null)
        {
            try
            {
                await JS.InvokeVoidAsync("KanbanFlow.initBoardDragDrop", dotNetRef);
                await JS.InvokeVoidAsync("KanbanFlow.initLeftNavDragDrop", dotNetRef);
            }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
            catch (InvalidOperationException) { }
        }
    }

    public async ValueTask DisposeAsync()
    {
        _cts.Cancel();
        _cts.Dispose();

        // A pending URL sync outlives the circuit otherwise: its Task.Delay would resume on a
        // disposed renderer and NavigateTo would throw into a fire-and-forget continuation nobody
        // observes. Cancelling makes the debounce return before it ever touches Nav.
        urlSyncCts?.Cancel();
        urlSyncCts?.Dispose();

        try
        {
            if (hasRenderedInteractively)
            {
                await JS.InvokeVoidAsync("KanbanFlow.destroySortables");
                await JS.InvokeVoidAsync("KanbanFlow.destroyProjectOutlineAccessibility");
            }
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
        catch (InvalidOperationException) { }

        dotNetRef?.Dispose();
    }

    // ── Helpers ──

    // The board's intra-column order. This sort used to live in KanbanColumn.razor and it is the
    // ONLY thing imposing it: LoadProject builds `allTasks` from an unordered
    // Features.SelectMany(f => f.Tasks), so nothing downstream re-imposes it. Dropping or
    // reversing it compiles, passes every unit test, and silently scrambles every board — the
    // "Todo column renders its cards in SortOrder sequence" E2E guard exists for exactly that.
    // TaskOrdering expands normal cross-feature integral ties by Id while preserving the former
    // SortOrder/Id order, then fractional drag ranks can sit between those stable identities (#307).
    private static IEnumerable<TaskItem> OrderTasksInColumn(IEnumerable<TaskItem> tasks) =>
        TaskOrdering.Order(tasks);

