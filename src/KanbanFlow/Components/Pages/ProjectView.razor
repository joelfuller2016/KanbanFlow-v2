@page "/project/{Id:int}"
@layout ProjectViewLayout
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ITaskService TaskSvc
@inject IHttpClientFactory HttpClientFactory
@implements IAsyncDisposable

<PageTitle>@(project?.Name ?? "Project") - KanbanFlow</PageTitle>

@if (loadError is not null)
{
    <div class="text-center py-5">
        <h4 class="text-danger">Something went wrong</h4>
        <p class="text-muted">@loadError</p>
        <button class="btn btn-primary mt-3" @onclick="GoHome">Back to Projects</button>
    </div>
}
else if (project is null)
{
    <div class="text-center py-5">
        @if (notFound)
        {
            <h4 class="text-muted">Project not found</h4>
            <button class="btn btn-primary mt-3" @onclick="GoHome">Back to Projects</button>
        }
        else
        {
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        }
    </div>
}
else
{
    <div class="project-shell d-flex @(outlineOpen ? "outline-open" : null)">

        <ProjectOutline Project="project"
                        ExpandedFeatures="expandedFeatures"
                        ExpandedTasks="expandedTasks"
                        OnGoHome="GoHome"
                        OnOpenEditProject="OpenEditModalForProject"
                        OnOpenAddProject="OpenAddModalForProject"
                        OnOpenEditFeature="OpenEditModalForFeature"
                        OnOpenAddFeature="OpenAddModalForFeature"
                        OnOpenAddTaskSubtask="OpenAddSubtaskForTask"
                        OnOpenAddSubtaskChild="OpenAddChildSubtaskFromOutline"
                        OnOpenEditTask="OpenEditModalForTask"
                        OnToggleFeature="ToggleFeature"
                        OnToggleTask="ToggleTask"
                        OnToggleTaskDone="ToggleTaskDone"
                        OnToggleOutlineSubtask="ToggleOutlineSubtask"
                        OnCloseOutline="CloseOutline" />

        <button type="button"
                class="project-outline-backdrop"
                aria-label="Hide project outline"
                @onclick="CloseOutline"></button>

        @* ── Right Panel: AI Action Bar + Kanban Board ── *@
        <div class="project-main flex-grow-1 d-flex flex-column overflow-hidden" style="min-width: 0;">
            <div class="border-bottom bg-white px-3 py-2">
                <div class="d-lg-none mb-3">
                    <button class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-2"
                            @onclick="ToggleOutline"
                            aria-expanded="@outlineOpen"
                            aria-controls="project-outline"
                            data-testid="toggle-project-outline-button"
                            style="min-height: 44px; padding: .5rem .75rem;">
                        @if (!outlineOpen) {
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                <path fill-rule="evenodd" d="M1 3h14v1H1V3zm0 4h14v1H1V7zm0 4h14v1H1v-1z"/>
                            </svg>
                            <span>Project outline</span>
                        } else {
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                <path d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8z"/>
                            </svg>
                            <span>Close outline</span>
                        }
                    </button>
                </div>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <div class="me-auto">
                        <div class="text-uppercase text-primary fw-bold small">AI tools</div>
                        <div class="text-muted small">Optional agent helpers for context and next-work planning.</div>
                    </div>
                    <button class="btn btn-sm btn-outline-primary" data-testid="ai-tools-toggle" aria-expanded="@ToAriaExpanded(aiControlsExpanded)" aria-controls="ai-tools-controls" @onclick="ToggleAiControls">
                        @(aiControlsExpanded ? "Hide AI tools" : "Show AI tools")
                    </button>
                </div>

                @* Keep #ai-tools-controls in the DOM at all times so the toggle button's
                   `aria-controls="ai-tools-controls"` always refers to a real element. Toggle
                   visibility by swapping `d-flex` ↔ `d-none`. Inline `display:none` would lose
                   to `.d-flex { display: flex !important }` here — `!important` from a class
                   beats a plain inline rule, so we have to use Bootstrap's own `d-none`
                   (which is also `!important`) and rely on the cascade order. *@
                <div id="ai-tools-controls" class="@(aiControlsExpanded ? "d-flex flex-wrap align-items-center gap-2 mt-2 pt-2 border-top" : "d-none")">
                    <span class="text-muted small me-auto">Inspect project context, choose next work, or prepare future AI actions.</span>
                    <button class="btn btn-sm btn-outline-primary" data-testid="ai-project-context-button" @onclick="ShowProjectContextAsync">
                        Project Context
                    </button>
                    <button class="btn btn-sm btn-outline-primary" data-testid="ai-next-tasks-button" @onclick="ShowNextTasksAsync">
                        Next Tasks
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" data-testid="ai-generate-tasks-button" disabled title="Coming soon: create tasks from project context">
                        Generate Tasks
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" data-testid="ai-assign-button" disabled title="Coming soon: claim and assign selected work to an AI agent">
                        Assign to AI
                    </button>
                </div>

                @if (aiPanelOpen)
                {
                    <div class="card mt-3 shadow-sm" data-testid="ai-action-panel">
                        <div class="card-header d-flex align-items-center py-2">
                            <strong>@aiPanelTitle</strong>
                            <button class="btn-close ms-auto" aria-label="Close AI panel" title="Close" @onclick="CloseAiPanel"></button>
                        </div>
                        <div class="card-body">
                            @if (aiLoading)
                            {
                                <div class="d-flex align-items-center text-muted">
                                    <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                                    Loading AI project data...
                                </div>
                            }
                            else if (aiPanelError is not null)
                            {
                                <div class="alert alert-danger mb-0">@aiPanelError</div>
                            }
                            else if (aiContext is not null)
                            {
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <div class="border rounded p-3 h-100">
                                            <div class="text-muted small">Project</div>
                                            <div class="fw-semibold">@aiContext.Project.Name</div>
                                            <MarkdownContent Markdown="@aiContext.Project.Description"
                                                             CssClass="small mb-0 text-muted"
                                                             EmptyText="No description yet." />
                                        </div>
                                    </div>
                                    <div class="col-md-8">
                                        <div class="row g-2">
                                            <div class="col-6 col-lg-3"><div class="border rounded p-2 text-center"><div class="fw-bold">@aiContext.Summary.FeatureCount</div><div class="small text-muted">Features</div></div></div>
                                            <div class="col-6 col-lg-3"><div class="border rounded p-2 text-center"><div class="fw-bold">@aiContext.Summary.TaskCount</div><div class="small text-muted">Tasks</div></div></div>
                                            <div class="col-6 col-lg-3"><div class="border rounded p-2 text-center"><div class="fw-bold">@aiContext.Summary.RequirementCount</div><div class="small text-muted">Requirements</div></div></div>
                                            <div class="col-6 col-lg-3"><div class="border rounded p-2 text-center"><div class="fw-bold">@CountOpenAiTasks()</div><div class="small text-muted">Open Tasks</div></div></div>
                                        </div>
                                    </div>
                                </div>
                                <div class="mt-3">
                                    <h6 class="mb-2">Current task snapshot</h6>
                                    <div class="list-group list-group-flush border rounded">
                                        @foreach (var task in aiContext.Tasks.Take(6))
                                        {
                                            <div class="list-group-item d-flex align-items-center gap-2">
                                                <span class="@GetPriorityBadgeClass(ParsePriority(task.Priority))">@task.Priority</span>
                                                <span class="fw-medium">@task.Name</span>
                                                <span class="text-muted small">@task.Status</span>
                                                @if (!string.IsNullOrWhiteSpace(task.ClaimedBy))
                                                {
                                                    <span class="badge text-bg-info ms-auto">Claimed by @task.ClaimedBy</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            else if (aiNextTasks.Count > 0)
                            {
                                <div class="list-group" data-testid="ai-next-tasks-list">
                                    @foreach (var recommendation in aiNextTasks)
                                    {
                                        <div class="list-group-item">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge text-bg-primary">#@recommendation.Rank</span>
                                                <strong>@recommendation.Name</strong>
                                                <span class="@GetPriorityBadgeClass(ParsePriority(recommendation.Priority))">@recommendation.Priority</span>
                                                <span class="text-muted small">@recommendation.Status</span>
                                            </div>
                                            <div class="small text-muted mt-1">@recommendation.Reason</div>
                                            <div class="small mt-1">Feature: @recommendation.FeatureName</div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="text-muted mb-0">No AI data to display yet.</p>
                            }
                        </div>
                    </div>
                }
            </div>

            <section class="requirements-panel border-bottom bg-light px-3 py-2" data-testid="requirements-panel" aria-labelledby="requirements-heading">
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <div class="me-auto">
                        <h2 id="requirements-heading" class="h6 mb-0">Requirements</h2>
                        <div class="text-muted small">@GetRequirementsSummaryText()</div>
                    </div>
                    <span class="badge text-bg-secondary" data-testid="requirements-count">@GetOrderedRequirements().Count</span>
                    <button class="btn btn-sm btn-outline-secondary" data-testid="requirements-toggle" aria-expanded="@ToAriaExpanded(requirementsExpanded)" aria-controls="requirements-content" @onclick="ToggleRequirements">
                        @(requirementsExpanded ? "Hide requirements" : "Show requirements")
                    </button>
                </div>

                @* Toggle visibility via inline `display:none;` rather than the `hidden`
                   attribute. The `hidden` attribute resolves to `display: none` from the UA
                   stylesheet, which loses to any element with a stronger rule (e.g. utility
                   classes that set `display: flex`). Inline style sits at the same specificity
                   level as those utility classes and `display:none` reliably wins for the
                   wrapper. Element stays in the DOM so `aria-controls` stays valid. *@
                <div id="requirements-content" style="@(requirementsExpanded ? null : "display:none;")">
                    @if (GetOrderedRequirements().Count == 0)
                    {
                        <div class="text-muted small border rounded bg-white p-3 mt-2" data-testid="requirements-empty-state">
                            <div class="fw-semibold text-body mb-1">No requirements captured yet.</div>
                            <div>
                                Requirements describe the project rules, constraints, and must-have outcomes that keep the board aligned.
                                They are shown here for people reviewing the project and included in the context AI agents use.
                            </div>
                            <div class="mt-2">
                                Requirement editing is API-only for now; any requirements added by your team or automation will appear here.
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="requirements-list d-flex flex-column gap-2 mt-2">
                            @foreach (var requirement in GetOrderedRequirements())
                            {
                                <article class="requirement-row border rounded bg-white p-2" data-testid="@($"requirement-row-{requirement.Id}")">
                                    <div class="d-flex flex-wrap align-items-start gap-2">
                                        <div class="fw-semibold me-auto">@requirement.Text</div>
                                        <span class="@GetRequirementPriorityBadgeClass(requirement.Priority)" data-testid="@($"requirement-priority-{requirement.Id}")">@requirement.Priority</span>
                                        <span class="@GetRequirementStatusBadgeClass(requirement.Status)" data-testid="@($"requirement-status-{requirement.Id}")">@GetRequirementStatusDisplayName(requirement.Status)</span>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(requirement.Description))
                                    {
                                        <MarkdownContent Markdown="@requirement.Description"
                                                         CssClass="small text-muted mb-1 mt-1" />
                                    }

                                    @if (requirement.Feature is not null || requirement.TaskItem is not null)
                                    {
                                        <div class="small text-muted mt-1">
                                            @if (requirement.Feature is not null)
                                            {
                                                <span>Feature: @requirement.Feature.Name</span>
                                            }
                                            @if (requirement.Feature is not null && requirement.TaskItem is not null)
                                            {
                                                <span class="mx-1">�</span>
                                            }
                                            @if (requirement.TaskItem is not null)
                                            {
                                                <span>Task: @requirement.TaskItem.Name</span>
                                            }
                                        </div>
                                    }
                                </article>
                            }
                        </div>
                    }
                </div>
            </section>
            @* The board is generic over <TItem, TStatus>. Pass the type arguments EXPLICITLY at
               every call site: with inferred type arguments Razor closes an EventCallback<T>
               handler before T is known and it degrades to object (CS1503). What a task *is* now
               lives entirely in these templates — the board no longer knows. *@
            <KanbanBoard TItem="TaskItem" TStatus="WorkStatus"
                         Items="allTasks"
                         StatusOf="t => t.Status"
                         IdOf="t => t.Id"
                         OrderColumnBy="OrderTasksInColumn"
                         DisplayName="GetStatusDisplayName"
                         Guidance="Drag cards between columns. Click a card for details.">
                <CardTemplate Context="task">
                    <KanbanCard @key="task.Id" Task="task" OnToggleTaskDone="ToggleTaskDone" OnOpenTaskDetail="OpenTaskDetail" />
                </CardTemplate>
                <ColumnHeaderActions Context="status">
                    <button class="btn btn-sm btn-outline-secondary py-0 px-2 ms-auto d-flex align-items-center gap-1" style="line-height: 1;"
                            @onclick="() => OpenAddModalForColumn(status)"
                            title="Add task to @(GetStatusDisplayName(status))"
                            aria-label="Add task to @(GetStatusDisplayName(status))"
                            data-testid="add-task-@status-button">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path fill-rule="evenodd" d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2"/>
                        </svg>
                        <span class="small">Task</span>
                    </button>
                </ColumnHeaderActions>
                <ColumnEmptyTemplate Context="status">
                    <div class="border rounded bg-white text-muted small text-center p-3" style="border-style: dashed !important;">
                        No tasks in @(GetStatusDisplayName(status)). Use “Task” to add one here.
                    </div>
                </ColumnEmptyTemplate>
            </KanbanBoard>
        </div>
    </div>
}

<KanbanFlow.Components.Shared.TaskDetailPanel
    Task="selectedTask"
    Features="project?.Features?.ToList()"
    IsOpen="detailPanelOpen"
    AddSubtaskParentId="detailPanelAddSubtaskParentId"
    OnClose="OnDetailClose"
    OnTaskUpdated="OnTaskUpdated"
    OnTaskDeleted="OnTaskDeleted" />

<KanbanFlow.Components.Shared.EditItemModal
    IsOpen="editModalOpen"
    EditMode="editModalMode"
    EditProjectId="Id"
    EditFeatureId="editModalFeatureId"
    EditTaskId="editModalTaskId"
    AllFeatures="project?.Features?.ToList()"
    InitialName="@editModalName"
    InitialDescription="@editModalDescription"
    InitialGoals="@editModalGoals"
    InitialReadme="@editModalReadme"
    InitialParentFeatureId="editModalParentFeatureId"
    InitialFeatureId="editModalTaskFeatureId"
    InitialStatus="editModalStatus"
    InitialPriority="editModalPriority"
    InitialAssignee="@editModalAssignee"
    OnClose="OnEditModalClose"
    OnSaved="OnEditSaved" />

<KanbanFlow.Components.Shared.AddItemModal
    IsOpen="addModalOpen"
    ProjectId="Id"
    Features="project?.Features?.ToList()"
    DefaultType="@addModalDefaultType"
    DefaultFeatureId="addModalDefaultFeatureId"
    DefaultStatus="addModalDefaultStatus"
    OnClose="OnAddModalClose"
    OnItemCreated="OnItemCreated" />

@code {
    [Parameter]
    public int Id { get; set; }

    private Project? project;
    private List<TaskItem> allTasks = [];
    private bool notFound;
    private string? loadError;
    private DotNetObjectReference<ProjectView>? dotNetRef;
    private bool sortablesInitialized;
    private bool hasRenderedInteractively;

    // Detail panel state
    private TaskItem? selectedTask;
    private bool detailPanelOpen;
    private int? detailPanelAddSubtaskParentId;
    private int? pendingDetailFocusReturnTaskId;
    private bool outlineOpen;

    private void ToggleOutline() => outlineOpen = !outlineOpen;

    private void CloseOutline() => outlineOpen = false;

    private void OpenTaskDetail(TaskItem task) => OpenTaskDetail(task, null, forceTaskExpansion: false);

    private void OpenTaskDetail(TaskItem task, int? addSubtaskParentId, bool forceTaskExpansion)
    {
        selectedTask = task;
        detailPanelAddSubtaskParentId = addSubtaskParentId;
        detailPanelOpen = true;

        if (forceTaskExpansion)
        {
            expandedTasks.Add(task.Id);
        }

        StateHasChanged();
    }

    private async Task OnDetailClose()
    {
        pendingDetailFocusReturnTaskId = selectedTask?.Id;
        detailPanelOpen = false;
        selectedTask = null;
        detailPanelAddSubtaskParentId = null;
        await LoadProject();
    }

    private async Task OnTaskUpdated()
    {
        var selectedTaskId = selectedTask?.Id;
        detailPanelAddSubtaskParentId = null;
        await LoadProject();

        if (selectedTaskId is int taskId)
        {
            selectedTask = allTasks.FirstOrDefault(t => t.Id == taskId);
        }
    }

    private async Task OnTaskDeleted(int taskId)
    {
        detailPanelOpen = false;
        selectedTask = null;
        await LoadProject();
    }
    private CancellationTokenSource _cts = new();

    // Feature/Task collapse state
    private HashSet<int> expandedFeatures = [];
    private HashSet<int> expandedTasks = [];
    private bool outlineExpansionInitialized;

    // Add Item modal state
    private bool addModalOpen;
    private string addModalDefaultType = "task";
    private int? addModalDefaultFeatureId;
    private WorkStatus? addModalDefaultStatus;

    // Edit Item modal state
    private bool editModalOpen;
    private EditItemType editModalMode;
    private int? editModalFeatureId;
    private int? editModalTaskId;
    private string? editModalName;
    private string? editModalDescription;
    private string? editModalGoals;
    private string? editModalReadme;
    private int? editModalParentFeatureId;
    private int? editModalTaskFeatureId;
    private int? editModalStatus;
    private int? editModalPriority;
    private string? editModalAssignee;

    // AI action bar state
    private bool aiControlsExpanded;
    private bool aiPanelOpen;
    private bool aiLoading;
    private string aiPanelTitle = string.Empty;
    private string? aiPanelError;
    private AiProjectContext? aiContext;
    private List<AiTaskRecommendation> aiNextTasks = [];

    // Requirements are compact by default so the board is visible sooner.
    private bool requirementsExpanded;

    protected override async Task OnInitializedAsync()
    {
        await LoadProject();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        hasRenderedInteractively = true;

        if (project is not null && !sortablesInitialized)
        {
            sortablesInitialized = true;
            dotNetRef = DotNetObjectReference.Create(this);
            try
            {
                // Small delay to ensure DOM is fully rendered before SortableJS init
                await Task.Delay(100);
                await JS.InvokeVoidAsync("KanbanFlow.initBoardDragDrop", dotNetRef);
                await JS.InvokeVoidAsync("KanbanFlow.initLeftNavDragDrop", dotNetRef);
            }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
            catch (InvalidOperationException) { }
        }

        if (project is not null)
        {
            try
            {
                await JS.InvokeVoidAsync("KanbanFlow.initProjectOutlineAccessibility");
            }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
            catch (InvalidOperationException) { }
        }

        if (pendingDetailFocusReturnTaskId is int taskId && !detailPanelOpen)
        {
            pendingDetailFocusReturnTaskId = null;
            try
            {
                await JS.InvokeVoidAsync("KanbanFlow.focusTaskCard", taskId);
            }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
            catch (InvalidOperationException) { }
        }
    }

    private void ToggleAiControls()
    {
        aiControlsExpanded = !aiControlsExpanded;
    }

    private void ToggleRequirements()
    {
        requirementsExpanded = !requirementsExpanded;
    }

    private static string ToAriaExpanded(bool expanded) => expanded ? "true" : "false";

    private async Task ShowProjectContextAsync()
    {
        await LoadAiPanelAsync("Project Context", async client =>
        {
            aiContext = await client.GetFromJsonAsync<AiProjectContext>(Nav.ToAbsoluteUri($"/api/projects/{Id}/context"), _cts.Token);
            aiNextTasks = [];
        });
    }

    private async Task ShowNextTasksAsync()
    {
        await LoadAiPanelAsync("Next Tasks", async client =>
        {
            var response = await client.GetFromJsonAsync<AiNextTasksResponse>(Nav.ToAbsoluteUri($"/api/projects/{Id}/next-tasks"), _cts.Token);
            aiNextTasks = response?.Recommendations ?? [];
            aiContext = null;
        });
    }

    private async Task LoadAiPanelAsync(string title, Func<HttpClient, Task> load)
    {
        aiPanelTitle = title;
        aiControlsExpanded = true;
        aiPanelOpen = true;
        aiLoading = true;
        aiPanelError = null;
        aiContext = null;
        aiNextTasks = [];

        try
        {
            // Pooled client via IHttpClientFactory — avoids the socket-exhaustion of
            // newing an HttpClient per click (#158). Callers pass absolute URIs, so no
            // BaseAddress is needed. Disposing the wrapper is safe; the pooled handler
            // is owned by the factory and survives.
            using var client = HttpClientFactory.CreateClient();
            await load(client);
        }
        catch (OperationCanceledException)
        {
            // Component disposed during load - expected
        }
        catch (Exception ex)
        {
            aiPanelError = ex.Message;
        }
        finally
        {
            aiLoading = false;
        }
    }

    private void CloseAiPanel()
    {
        aiPanelOpen = false;
        aiPanelError = null;
        aiContext = null;
        aiNextTasks = [];
    }

    private int CountOpenAiTasks() => aiContext?.Tasks.Count(t => t.Status != "Done") ?? 0;

    private async Task LoadProject()
    {
        try
        {
            using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            var loaded = await db.Projects
                .Include(p => p.Features)
                    .ThenInclude(f => f.Tasks)
                        .ThenInclude(t => t.Subtasks)
                .Include(p => p.Features)
                    .ThenInclude(f => f.Tasks)
                        .ThenInclude(t => t.AcceptanceCriteria)
                .Include(p => p.Features)
                    .ThenInclude(f => f.Tasks)
                        .ThenInclude(t => t.Dependencies)
                            .ThenInclude(d => d.DependsOnTaskItem)
                .Include(p => p.Features)
                    .ThenInclude(f => f.ChildFeatures)
                .Include(p => p.Requirements)
                    .ThenInclude(r => r.Feature)
                .Include(p => p.Requirements)
                    .ThenInclude(r => r.TaskItem)
                .AsSplitQuery()
                .FirstOrDefaultAsync(p => p.Id == Id, _cts.Token);

            if (_cts.IsCancellationRequested) return;

            if (loaded is null)
            {
                notFound = true;
                return;
            }

            project = loaded;
            allTasks = project.Features.SelectMany(f => f.Tasks).ToList();
            if (selectedTask is not null)
            {
                selectedTask = allTasks.FirstOrDefault(t => t.Id == selectedTask.Id);
                detailPanelOpen = detailPanelOpen && selectedTask is not null;
            }

            InitializeOutlineExpansion();

            loadError = null;
        }
        catch (OperationCanceledException)
        {
            // Component disposed during load - expected
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
    }

    private void InitializeOutlineExpansion()
    {
        if (project is null || outlineExpansionInitialized)
        {
            return;
        }

        // Expand all features and tasks on initial page load only. Subsequent reloads
        // refresh the data model without overwriting the user's collapse choices.
        foreach (var f in project.Features)
        {
            expandedFeatures.Add(f.Id);
        }

        foreach (var t in allTasks.Where(t => t.Subtasks.Count > 0))
        {
            expandedTasks.Add(t.Id);
        }

        outlineExpansionInitialized = true;
    }

    private void GoHome()
    {
        Nav.NavigateTo("/");
    }

    private async Task ToggleOutlineSubtask(Subtask subtask)
    {
        subtask.Completed = !subtask.Completed;
        try
        {
            using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            db.Subtasks.Attach(subtask);
            db.Entry(subtask).Property(s => s.Completed).IsModified = true;
            await db.SaveChangesAsync(_cts.Token);
            StateHasChanged();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { loadError = ex.Message; }
    }

