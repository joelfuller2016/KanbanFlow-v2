@page "/project/{Id:int}"
@layout ProjectViewLayout
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>@(project?.Name ?? "Project") - KanbanFlow</PageTitle>

@if (loadError is not null)
{
    <div class="text-center py-5">
        <h4 class="text-danger">Something went wrong</h4>
        <p class="text-muted">@loadError</p>
        <button class="btn btn-primary mt-3" @onclick="GoHome">Back to Projects</button>
    </div>
}
else if (project is null)
{
    <div class="text-center py-5">
        @if (notFound)
        {
            <h4 class="text-muted">Project not found</h4>
            <button class="btn btn-primary mt-3" @onclick="GoHome">Back to Projects</button>
        }
        else
        {
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        }
    </div>
}
else
{
    <div class="d-flex" style="height: calc(100vh - 56px);">

        <ProjectOutline Project="project"
                        ExpandedFeatures="expandedFeatures"
                        ExpandedTasks="expandedTasks"
                        OnGoHome="GoHome"
                        OnOpenEditProject="OpenEditModalForProject"
                        OnOpenAddProject="OpenAddModalForProject"
                        OnOpenEditFeature="OpenEditModalForFeature"
                        OnOpenAddFeature="OpenAddModalForFeature"
                        OnOpenEditTask="OpenEditModalForTask"
                        OnToggleFeature="ToggleFeature"
                        OnToggleTask="ToggleTask"
                        OnToggleTaskDone="ToggleTaskDone"
                        OnToggleOutlineSubtask="ToggleOutlineSubtask" />

        @* ── Right Panel: AI Action Bar + Kanban Board ── *@
        <div class="flex-grow-1 d-flex flex-column overflow-hidden" style="min-width: 0;">
            <div class="border-bottom bg-white p-3">
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <div class="me-auto">
                        <div class="text-uppercase text-primary fw-bold small">AI project controls</div>
                        <div class="text-muted small">Inspect context, choose next work, and prepare agent actions.</div>
                    </div>
                    <button class="btn btn-sm btn-outline-primary" data-testid="ai-project-context-button" @onclick="ShowProjectContextAsync">
                        Project Context
                    </button>
                    <button class="btn btn-sm btn-outline-primary" data-testid="ai-next-tasks-button" @onclick="ShowNextTasksAsync">
                        Next Tasks
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" data-testid="ai-generate-tasks-button" disabled title="Coming soon: create tasks from project context">
                        Generate Tasks
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" data-testid="ai-assign-button" disabled title="Coming soon: claim and assign selected work to an AI agent">
                        Assign to AI
                    </button>
                </div>

                @if (aiPanelOpen)
                {
                    <div class="card mt-3 shadow-sm" data-testid="ai-action-panel">
                        <div class="card-header d-flex align-items-center py-2">
                            <strong>@aiPanelTitle</strong>
                            <button class="btn btn-sm btn-link text-muted ms-auto" @onclick="CloseAiPanel">Close</button>
                        </div>
                        <div class="card-body">
                            @if (aiLoading)
                            {
                                <div class="d-flex align-items-center text-muted">
                                    <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                                    Loading AI project data...
                                </div>
                            }
                            else if (aiPanelError is not null)
                            {
                                <div class="alert alert-danger mb-0">@aiPanelError</div>
                            }
                            else if (aiContext is not null)
                            {
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <div class="border rounded p-3 h-100">
                                            <div class="text-muted small">Project</div>
                                            <div class="fw-semibold">@aiContext.Project.Name</div>
                                            <p class="small mb-0 text-muted">@(!string.IsNullOrWhiteSpace(aiContext.Project.Description) ? aiContext.Project.Description : "No description yet.")</p>
                                        </div>
                                    </div>
                                    <div class="col-md-8">
                                        <div class="row g-2">
                                            <div class="col-6 col-lg-3"><div class="border rounded p-2 text-center"><div class="fw-bold">@aiContext.Summary.FeatureCount</div><div class="small text-muted">Features</div></div></div>
                                            <div class="col-6 col-lg-3"><div class="border rounded p-2 text-center"><div class="fw-bold">@aiContext.Summary.TaskCount</div><div class="small text-muted">Tasks</div></div></div>
                                            <div class="col-6 col-lg-3"><div class="border rounded p-2 text-center"><div class="fw-bold">@aiContext.Summary.RequirementCount</div><div class="small text-muted">Requirements</div></div></div>
                                            <div class="col-6 col-lg-3"><div class="border rounded p-2 text-center"><div class="fw-bold">@CountOpenAiTasks()</div><div class="small text-muted">Open Tasks</div></div></div>
                                        </div>
                                    </div>
                                </div>
                                <div class="mt-3">
                                    <h6 class="mb-2">Current task snapshot</h6>
                                    <div class="list-group list-group-flush border rounded">
                                        @foreach (var task in aiContext.Tasks.Take(6))
                                        {
                                            <div class="list-group-item d-flex align-items-center gap-2">
                                                <span class="@GetPriorityBadgeClass(ParsePriority(task.Priority))">@task.Priority</span>
                                                <span class="fw-medium">@task.Name</span>
                                                <span class="text-muted small">@task.Status</span>
                                                @if (!string.IsNullOrWhiteSpace(task.ClaimedBy))
                                                {
                                                    <span class="badge text-bg-info ms-auto">Claimed by @task.ClaimedBy</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            else if (aiNextTasks.Count > 0)
                            {
                                <div class="list-group" data-testid="ai-next-tasks-list">
                                    @foreach (var recommendation in aiNextTasks)
                                    {
                                        <div class="list-group-item">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge text-bg-primary">#@recommendation.Rank</span>
                                                <strong>@recommendation.Name</strong>
                                                <span class="@GetPriorityBadgeClass(ParsePriority(recommendation.Priority))">@recommendation.Priority</span>
                                                <span class="text-muted small">@recommendation.Status</span>
                                            </div>
                                            <div class="small text-muted mt-1">@recommendation.Reason</div>
                                            <div class="small mt-1">Feature: @recommendation.FeatureName</div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="text-muted mb-0">No AI data to display yet.</p>
                            }
                        </div>
                    </div>
                }
            </div>

            <section class="requirements-panel border-bottom bg-light p-3" data-testid="requirements-panel" aria-labelledby="requirements-heading">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <div class="me-auto">
                        <h2 id="requirements-heading" class="h6 mb-0">Requirements</h2>
                        <div class="text-muted small">Project-level requirements visible to humans and AI agents.</div>
                    </div>
                    <span class="badge text-bg-secondary" data-testid="requirements-count">@GetOrderedRequirements().Count</span>
                </div>

                @if (GetOrderedRequirements().Count == 0)
                {
                    <div class="text-muted small border rounded bg-white p-3" data-testid="requirements-empty-state">
                        No requirements yet. Requirements added through the API will appear here.
                    </div>
                }
                else
                {
                    <div class="requirements-list d-flex flex-column gap-2">
                        @foreach (var requirement in GetOrderedRequirements())
                        {
                            <article class="requirement-row border rounded bg-white p-2" data-testid="@($"requirement-row-{requirement.Id}")">
                                <div class="d-flex flex-wrap align-items-start gap-2">
                                    <div class="fw-semibold me-auto">@requirement.Text</div>
                                    <span class="@GetRequirementPriorityBadgeClass(requirement.Priority)" data-testid="@($"requirement-priority-{requirement.Id}")">@requirement.Priority</span>
                                    <span class="@GetRequirementStatusBadgeClass(requirement.Status)" data-testid="@($"requirement-status-{requirement.Id}")">@GetRequirementStatusDisplayName(requirement.Status)</span>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(requirement.Description))
                                {
                                    <p class="small text-muted mb-1 mt-1">@requirement.Description</p>
                                }

                                @if (requirement.Feature is not null || requirement.TaskItem is not null)
                                {
                                    <div class="small text-muted mt-1">
                                        @if (requirement.Feature is not null)
                                        {
                                            <span>Feature: @requirement.Feature.Name</span>
                                        }
                                        @if (requirement.Feature is not null && requirement.TaskItem is not null)
                                        {
                                            <span class="mx-1">•</span>
                                        }
                                        @if (requirement.TaskItem is not null)
                                        {
                                            <span>Task: @requirement.TaskItem.Name</span>
                                        }
                                    </div>
                                }
                            </article>
                        }
                    </div>
                }
            </section>

            <KanbanBoard AllTasks="allTasks"
                         OnAddTask="OpenAddModalForColumn"
                         OnToggleTaskDone="ToggleTaskDone"
                         OnOpenTaskDetail="OpenTaskDetail" />
        </div>
    </div>
}

<KanbanFlow.Components.Shared.TaskDetailPanel
    Task="selectedTask"
    Features="project?.Features?.ToList()"
    IsOpen="detailPanelOpen"
    OnClose="OnDetailClose"
    OnTaskUpdated="OnTaskUpdated"
    OnTaskDeleted="OnTaskDeleted" />

<KanbanFlow.Components.Shared.EditItemModal
    IsOpen="editModalOpen"
    EditMode="editModalMode"
    EditProjectId="Id"
    EditFeatureId="editModalFeatureId"
    EditTaskId="editModalTaskId"
    AllFeatures="project?.Features?.ToList()"
    InitialName="@editModalName"
    InitialDescription="@editModalDescription"
    InitialGoals="@editModalGoals"
    InitialReadme="@editModalReadme"
    InitialParentFeatureId="editModalParentFeatureId"
    InitialFeatureId="editModalTaskFeatureId"
    InitialStatus="editModalStatus"
    InitialPriority="editModalPriority"
    InitialAssignee="@editModalAssignee"
    OnClose="OnEditModalClose"
    OnSaved="OnEditSaved" />

<KanbanFlow.Components.Shared.AddItemModal
    IsOpen="addModalOpen"
    ProjectId="Id"
    Features="project?.Features?.ToList()"
    DefaultType="@addModalDefaultType"
    DefaultFeatureId="addModalDefaultFeatureId"
    DefaultStatus="addModalDefaultStatus"
    OnClose="OnAddModalClose"
    OnItemCreated="OnItemCreated" />

@code {
    [Parameter]
    public int Id { get; set; }

    private Project? project;
    private List<TaskItem> allTasks = [];
    private bool notFound;
    private string? loadError;
    private DotNetObjectReference<ProjectView>? dotNetRef;
    private bool sortablesInitialized;
    private bool hasRenderedInteractively;

    // Detail panel state
    private TaskItem? selectedTask;
    private bool detailPanelOpen;

    private void OpenTaskDetail(TaskItem task)
    {
        selectedTask = task;
        detailPanelOpen = true;
        StateHasChanged();
    }

    private async Task OnDetailClose()
    {
        detailPanelOpen = false;
        selectedTask = null;
        await LoadProject();
    }

    private async Task OnTaskUpdated()
    {
        await LoadProject();
    }

    private async Task OnTaskDeleted(int taskId)
    {
        detailPanelOpen = false;
        selectedTask = null;
        await LoadProject();
    }
    private CancellationTokenSource _cts = new();

    // Feature/Task collapse state
    private HashSet<int> expandedFeatures = [];
    private HashSet<int> expandedTasks = [];

    // Add Item modal state
    private bool addModalOpen;
    private string addModalDefaultType = "task";
    private int? addModalDefaultFeatureId;
    private WorkStatus? addModalDefaultStatus;

    // Edit Item modal state
    private bool editModalOpen;
    private EditItemType editModalMode;
    private int? editModalFeatureId;
    private int? editModalTaskId;
    private string? editModalName;
    private string? editModalDescription;
    private string? editModalGoals;
    private string? editModalReadme;
    private int? editModalParentFeatureId;
    private int? editModalTaskFeatureId;
    private int? editModalStatus;
    private int? editModalPriority;
    private string? editModalAssignee;

    // AI action bar state
    private bool aiPanelOpen;
    private bool aiLoading;
    private string aiPanelTitle = string.Empty;
    private string? aiPanelError;
    private AiProjectContext? aiContext;
    private List<AiTaskRecommendation> aiNextTasks = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadProject();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        hasRenderedInteractively = true;

        if (project is not null && !sortablesInitialized)
        {
            sortablesInitialized = true;
            dotNetRef = DotNetObjectReference.Create(this);
            try
            {
                // Small delay to ensure DOM is fully rendered before SortableJS init
                await Task.Delay(100);
                await JS.InvokeVoidAsync("KanbanFlow.initBoardDragDrop", dotNetRef);
                await JS.InvokeVoidAsync("KanbanFlow.initLeftNavDragDrop", dotNetRef);
            }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
            catch (InvalidOperationException) { }
        }
    }

    private async Task ShowProjectContextAsync()
    {
        await LoadAiPanelAsync("Project Context", async client =>
        {
            aiContext = await client.GetFromJsonAsync<AiProjectContext>(Nav.ToAbsoluteUri($"/api/projects/{Id}/context"), _cts.Token);
            aiNextTasks = [];
        });
    }

    private async Task ShowNextTasksAsync()
    {
        await LoadAiPanelAsync("Next Tasks", async client =>
        {
            var response = await client.GetFromJsonAsync<AiNextTasksResponse>(Nav.ToAbsoluteUri($"/api/projects/{Id}/next-tasks"), _cts.Token);
            aiNextTasks = response?.Recommendations ?? [];
            aiContext = null;
        });
    }

    private async Task LoadAiPanelAsync(string title, Func<HttpClient, Task> load)
    {
        aiPanelTitle = title;
        aiPanelOpen = true;
        aiLoading = true;
        aiPanelError = null;
        aiContext = null;
        aiNextTasks = [];

        try
        {
            using var client = new HttpClient();
            await load(client);
        }
        catch (OperationCanceledException)
        {
            // Component disposed during load - expected
        }
        catch (Exception ex)
        {
            aiPanelError = ex.Message;
        }
        finally
        {
            aiLoading = false;
        }
    }

    private void CloseAiPanel()
    {
        aiPanelOpen = false;
        aiPanelError = null;
        aiContext = null;
        aiNextTasks = [];
    }

    private int CountOpenAiTasks() => aiContext?.Tasks.Count(t => t.Status != "Done") ?? 0;

    private async Task LoadProject()
    {
        try
        {
            using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            var loaded = await db.Projects
                .Include(p => p.Features)
                    .ThenInclude(f => f.Tasks)
                        .ThenInclude(t => t.Subtasks)
                .Include(p => p.Features)
                    .ThenInclude(f => f.ChildFeatures)
                .Include(p => p.Requirements)
                    .ThenInclude(r => r.Feature)
                .Include(p => p.Requirements)
                    .ThenInclude(r => r.TaskItem)
                .AsSplitQuery()
                .FirstOrDefaultAsync(p => p.Id == Id, _cts.Token);

            if (_cts.IsCancellationRequested) return;

            if (loaded is null)
            {
                notFound = true;
                return;
            }

            project = loaded;
            allTasks = project.Features.SelectMany(f => f.Tasks).ToList();

            // Expand all features and tasks by default
            foreach (var f in project.Features)
            {
                expandedFeatures.Add(f.Id);
            }
            foreach (var t in allTasks.Where(t => t.Subtasks.Count > 0))
            {
                expandedTasks.Add(t.Id);
            }

            loadError = null;
        }
        catch (OperationCanceledException)
        {
            // Component disposed during load - expected
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
    }

    private void GoHome()
    {
        Nav.NavigateTo("/");
    }

    private async Task ToggleOutlineSubtask(Subtask subtask)
    {
        subtask.Completed = !subtask.Completed;
        try
        {
            using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            db.Subtasks.Attach(subtask);
            db.Entry(subtask).Property(s => s.Completed).IsModified = true;
            await db.SaveChangesAsync(_cts.Token);
            StateHasChanged();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { loadError = ex.Message; }
    }

    // ── Feature/Task collapse/expand ──

    private void ToggleFeature(int featureId)
    {
        if (!expandedFeatures.Remove(featureId))
        {
            expandedFeatures.Add(featureId);
        }
    }

    private void ToggleTask(int taskId)
    {
        if (!expandedTasks.Remove(taskId))
        {
            expandedTasks.Add(taskId);
        }
    }

    // ── Task checkbox toggle ──

    private async Task ToggleTaskDone(TaskItem task)
    {
        var newStatus = task.Status == WorkStatus.Done ? WorkStatus.Todo : WorkStatus.Done;
        var markSubtasksCompleted = newStatus == WorkStatus.Done;
        try
        {
            using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            var entity = await db.Tasks.Include(t => t.Subtasks).FirstOrDefaultAsync(t => t.Id == task.Id, _cts.Token);
            if (entity is null) return;

            entity.Status = newStatus;
            entity.UpdatedAt = DateTime.UtcNow;
            entity.CompletedAt = newStatus == WorkStatus.Done ? DateTime.UtcNow : null;

            // Cascade: mark all subtasks completed/uncompleted
            foreach (var subtask in entity.Subtasks)
            {
                subtask.Completed = markSubtasksCompleted;
            }

            await db.SaveChangesAsync(_cts.Token);

            await LoadProject();
            await ReinitializeSortables();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { loadError = ex.Message; }
    }

    // ── Add Item Modal ──

    private void OpenAddModalForProject() => OpenAddModal("feature", null, null);
    private void OpenAddModalForFeature(int featureId) => OpenAddModal("task", featureId, null);
    private void OpenAddModalForColumn(WorkStatus status) => OpenAddModal("task", null, status);

    private void OpenAddModal(string defaultType, int? featureId, WorkStatus? status)
    {
        addModalDefaultType = defaultType;
        addModalDefaultFeatureId = featureId;
        addModalDefaultStatus = status;
        addModalOpen = true;
    }

    private async Task OnAddModalClose()
    {
        addModalOpen = false;
        StateHasChanged();
        await Task.CompletedTask;
    }

    private async Task OnItemCreated()
    {
        await LoadProject();
        await ReinitializeSortables();
    }

    // ── Edit Item Modal ──

    private void OpenEditModalForProject()
    {
        if (project is null) return;
        editModalMode = EditItemType.Project;
        editModalFeatureId = null;
        editModalTaskId = null;
        editModalName = project.Name;
        editModalDescription = project.Description;
        editModalGoals = project.Goals;
        editModalReadme = project.Readme;
        editModalOpen = true;
    }

    private void OpenEditModalForFeature(Feature feature)
    {
        editModalMode = EditItemType.Feature;
        editModalFeatureId = feature.Id;
        editModalTaskId = null;
        editModalName = feature.Name;
        editModalDescription = feature.Description;
        editModalParentFeatureId = feature.ParentFeatureId.HasValue ? feature.ParentFeatureId.Value : 0;
        editModalOpen = true;
    }

    private void OpenEditModalForTask(TaskItem task)
    {
        editModalMode = EditItemType.Task;
        editModalFeatureId = null;
        editModalTaskId = task.Id;
        editModalName = task.Name;
        editModalDescription = task.Description;
        editModalTaskFeatureId = task.FeatureId;
        editModalStatus = (int)task.Status;
        editModalPriority = (int)task.Priority;
        editModalAssignee = task.Assignee;
        editModalOpen = true;
    }

    private async Task OnEditModalClose()
    {
        editModalOpen = false;
        StateHasChanged();
        await Task.CompletedTask;
    }

    private async Task OnEditSaved()
    {
        await LoadProject();
    }

    // ── Drag-and-Drop Handlers ──

    [JSInvokable]
    public async Task OnCardMoved(int taskId, string newStatus, int newIndex)
    {
        if (!Enum.TryParse<WorkStatus>(newStatus, out var status)) return;

        try
        {
            using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            var task = await db.Tasks.FindAsync(new object[] { taskId }, _cts.Token);
            if (task is null) return;

            var oldStatus = task.Status;
            task.Status = status;
            task.UpdatedAt = DateTime.UtcNow;

            // Set CompletedAt when moved to Done, clear if moved away
            if (status == WorkStatus.Done && oldStatus != WorkStatus.Done)
            {
                task.CompletedAt = DateTime.UtcNow;
            }
            else if (status != WorkStatus.Done)
            {
                task.CompletedAt = null;
            }

            await db.SaveChangesAsync(_cts.Token);

            // Reindex all tasks in the target column
            var columnTasks = await db.Tasks
                .Include(t => t.Feature)
                .Where(t => t.Status == status && t.Feature.ProjectId == Id)
                .OrderBy(t => t.SortOrder)
                .ToListAsync(_cts.Token);

            // Remove the moved task and insert at the new index
            columnTasks.Remove(task);
            var insertIndex = Math.Min(newIndex, columnTasks.Count);
            columnTasks.Insert(insertIndex, task);

            for (int i = 0; i < columnTasks.Count; i++)
            {
                columnTasks[i].SortOrder = i;
            }

            await db.SaveChangesAsync(_cts.Token);
            await LoadProject();
            await ReinitializeSortables();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
    }

    [JSInvokable]
    public async Task OnTaskReordered(int taskId, int newFeatureId, int newIndex)
    {
        try
        {
            using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            var task = await db.Tasks.FindAsync(new object[] { taskId }, _cts.Token);
            if (task is null) return;

            task.FeatureId = newFeatureId;
            task.UpdatedAt = DateTime.UtcNow;
            await db.SaveChangesAsync(_cts.Token);

            // Reindex all tasks in the target feature
            var featureTasks = await db.Tasks
                .Where(t => t.FeatureId == newFeatureId)
                .OrderBy(t => t.SortOrder)
                .ToListAsync(_cts.Token);

            featureTasks.Remove(task);
            var insertIndex = Math.Min(newIndex, featureTasks.Count);
            featureTasks.Insert(insertIndex, task);

            for (int i = 0; i < featureTasks.Count; i++)
            {
                featureTasks[i].SortOrder = i;
            }

            await db.SaveChangesAsync(_cts.Token);
            await LoadProject();
            await ReinitializeSortables();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
    }

    private async Task ReinitializeSortables()
    {
        StateHasChanged();
        await Task.Yield();
        if (dotNetRef is not null)
        {
            try
            {
                await JS.InvokeVoidAsync("KanbanFlow.initBoardDragDrop", dotNetRef);
                await JS.InvokeVoidAsync("KanbanFlow.initLeftNavDragDrop", dotNetRef);
            }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
            catch (InvalidOperationException) { }
        }
    }

    public async ValueTask DisposeAsync()
    {
        _cts.Cancel();
        _cts.Dispose();

        try
        {
            if (hasRenderedInteractively)
            {
                await JS.InvokeVoidAsync("KanbanFlow.destroySortables");
            }
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
        catch (InvalidOperationException) { }

        dotNetRef?.Dispose();
    }

    // ── Helpers ──

    private static string GetStatusDisplayName(WorkStatus status) => status switch
    {
        WorkStatus.Backlog => "Backlog",
        WorkStatus.Todo => "To Do",
        WorkStatus.InProgress => "In Progress",
        WorkStatus.Review => "Review",
        WorkStatus.Done => "Done",
        _ => status.ToString()
    };

    private static string GetStatusDotColor(WorkStatus status) => status switch
    {
        WorkStatus.Backlog => "#6c757d",
        WorkStatus.Todo => "#0d6efd",
        WorkStatus.InProgress => "#fd7e14",
        WorkStatus.Review => "#6f42c1",
        WorkStatus.Done => "#198754",
        _ => "#6c757d"
    };

    private static string GetPriorityBadgeClass(TaskPriority priority) => priority switch
    {
        TaskPriority.Low => "badge bg-secondary",
        TaskPriority.Medium => "badge bg-warning text-dark",
        TaskPriority.High => "badge bg-danger",
        TaskPriority.Critical => "badge bg-danger fw-bold",
        _ => "badge bg-secondary"
    };

    private static string GetPriorityTextClass(TaskPriority priority) => priority switch
    {
        TaskPriority.Low => "text-secondary",
        TaskPriority.Medium => "text-warning",
        TaskPriority.High => "text-danger",
        TaskPriority.Critical => "text-danger fw-bold",
        _ => "text-secondary"
    };

    private static TaskPriority ParsePriority(string? priority) =>
        Enum.TryParse<TaskPriority>(priority, ignoreCase: true, out var parsed) ? parsed : TaskPriority.Low;

    private List<Requirement> GetOrderedRequirements() => project?.Requirements
        .OrderBy(r => r.SortOrder)
        .ThenBy(r => r.Id)
        .ToList() ?? [];

    private static string GetRequirementPriorityBadgeClass(RequirementPriority priority) => priority switch
    {
        RequirementPriority.P0 => "badge text-bg-danger",
        RequirementPriority.P1 => "badge text-bg-warning",
        RequirementPriority.P2 => "badge text-bg-secondary",
        _ => "badge text-bg-secondary"
    };

    private static string GetRequirementStatusBadgeClass(RequirementStatus status) => status switch
    {
        RequirementStatus.Open => "badge text-bg-primary",
        RequirementStatus.InProgress => "badge text-bg-info",
        RequirementStatus.Done => "badge text-bg-success",
        _ => "badge text-bg-secondary"
    };

    private static string GetRequirementStatusDisplayName(RequirementStatus status) => status switch
    {
        RequirementStatus.InProgress => "In Progress",
        _ => status.ToString()
    };

    private sealed class AiProjectContext
    {
        public AiProject Project { get; set; } = new();
        public AiContextSummary Summary { get; set; } = new();
        public List<AiContextTask> Tasks { get; set; } = [];
    }

    private sealed class AiProject
    {
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
    }

    private sealed class AiContextSummary
    {
        public int FeatureCount { get; set; }
        public int TaskCount { get; set; }
        public int RequirementCount { get; set; }
    }

    private sealed class AiContextTask
    {
        public string Name { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
        public string Priority { get; set; } = string.Empty;
        public string? ClaimedBy { get; set; }
    }

    private sealed class AiNextTasksResponse
    {
        public List<AiTaskRecommendation> Recommendations { get; set; } = [];
    }

    private sealed class AiTaskRecommendation
    {
        public int Rank { get; set; }
        public string Name { get; set; } = string.Empty;
        public string FeatureName { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
        public string Priority { get; set; } = string.Empty;
        public string Reason { get; set; } = string.Empty;
    }

}
