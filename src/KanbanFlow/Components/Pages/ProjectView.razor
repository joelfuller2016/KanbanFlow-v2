    // ── Drag-and-Drop Handlers ──

    [JSInvokable]
    public async Task OnCardMoved(int taskId, string newStatus, int newIndex)
    {
        // Reject undefined enum values up-front (closes part of #89 for the UI).
        if (!Enum.TryParse<WorkStatus>(newStatus, out var status)
            || !Enum.IsDefined(typeof(WorkStatus), status))
        {
            return;
        }

        try
        {
            // Status change goes through ITaskService — produces the StatusChange comment
            // and TaskStatusChanged activity event (closes UI half of #88 for status moves).
            await TaskSvc.ChangeStatusAsync(taskId, status, actor: "User", _cts.Token);

            // Reorder is still inline; service extraction for reorder is deferred to a
            // follow-up PR (TODO: ITaskService.ReorderAsync).
            using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            var task = await db.Tasks.FindAsync(new object[] { taskId }, _cts.Token);
            if (task is null) return;

            var columnTasks = await db.Tasks
                .Include(t => t.Feature)
                .Where(t => t.Status == status && t.Feature.ProjectId == Id)
                .OrderBy(t => t.SortOrder)
                .ThenBy(t => t.Id) // #207: deterministic pre-reindex read when SortOrder ties
                .ToListAsync(_cts.Token);

            columnTasks.Remove(task);
            var insertIndex = Math.Min(newIndex, columnTasks.Count);
            columnTasks.Insert(insertIndex, task);

            for (int i = 0; i < columnTasks.Count; i++)
            {
                columnTasks[i].SortOrder = i;
            }

            await db.SaveChangesAsync(_cts.Token);
            await LoadProject();
            await ReinitializeSortables();
        }
        catch (OperationCanceledException) { }
        catch (TaskNotFoundException) { /* task vanished mid-drag — drop silently */ }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
    }

    [JSInvokable]
    public async Task OnTaskReordered(int taskId, int newFeatureId, int newIndex)
    {
        try
        {
            using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
            var task = await db.Tasks.FindAsync(new object[] { taskId }, _cts.Token);
            if (task is null) return;

            task.FeatureId = newFeatureId;
            task.UpdatedAt = DateTime.UtcNow;
            await db.SaveChangesAsync(_cts.Token);

            // Reindex all tasks in the target feature
            var featureTasks = await db.Tasks
                .Where(t => t.FeatureId == newFeatureId)
                .OrderBy(t => t.SortOrder)
                .ThenBy(t => t.Id) // #207: deterministic pre-reindex read when SortOrder ties
                .ToListAsync(_cts.Token);

            featureTasks.Remove(task);
            var insertIndex = Math.Min(newIndex, featureTasks.Count);
            featureTasks.Insert(insertIndex, task);

            for (int i = 0; i < featureTasks.Count; i++)
            {
                featureTasks[i].SortOrder = i;
            }

            await db.SaveChangesAsync(_cts.Token);
            await LoadProject();
            await ReinitializeSortables();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
    }

    private async Task ReinitializeSortables()
    {
        StateHasChanged();
        await Task.Yield();
        if (dotNetRef is not null)
        {
            try
            {
                await JS.InvokeVoidAsync("KanbanFlow.initBoardDragDrop", dotNetRef);
                await JS.InvokeVoidAsync("KanbanFlow.initLeftNavDragDrop", dotNetRef);
            }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
            catch (InvalidOperationException) { }
        }
    }

    public async ValueTask DisposeAsync()
    {
        _cts.Cancel();
        _cts.Dispose();

        try
        {
            if (hasRenderedInteractively)
            {
                await JS.InvokeVoidAsync("KanbanFlow.destroySortables");
                await JS.InvokeVoidAsync("KanbanFlow.destroyProjectOutlineAccessibility");
            }
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
        catch (InvalidOperationException) { }

        dotNetRef?.Dispose();
    }

    // ── Helpers ──

    // The board's intra-column order. This sort used to live in KanbanColumn.razor and it is the
    // ONLY thing imposing it: LoadProject builds `allTasks` from an unordered
    // Features.SelectMany(f => f.Tasks), so nothing downstream re-imposes it. Dropping or
    // reversing it compiles, passes every unit test, and silently scrambles every board — the
    // "Todo column renders its cards in SortOrder sequence" E2E guard exists for exactly that.
    // ThenBy(Id) is the #207 deterministic tiebreak when SortOrder ties.
    private static IEnumerable<TaskItem> OrderTasksInColumn(IEnumerable<TaskItem> tasks) =>
        tasks.OrderBy(t => t.SortOrder).ThenBy(t => t.Id);

