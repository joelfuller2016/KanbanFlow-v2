    protected override async Task OnInitializedAsync()
    {
        // Read the filter off the URL once per project visit (#112). The URL is this filter's
        // only persistence, so a reload or a shared link must restore the exact view — but reading
        // it on every parameter set would fight the user: SyncFilterToUrl below navigates on every
        // keystroke, each navigation re-runs OnParametersSet, and a re-read there would race the
        // very field being typed into. One read in, one write out.
        //
        // No LocationChanged subscription is needed, and that depends ENTIRELY on `replace: true`
        // in SyncFilterToUrlAsync: every filter write replaces the page's single history entry, so
        // this route never accumulates a second one and Back always leaves the page (measured:
        // history.length 3, Back from /project/N?q=Keep%20Alpha lands on "/", component disposed and
        // re-created, OnInitialized runs again). Switch that flag to `false` and Back becomes an
        // in-page popstate this component would ignore — at which point subscribe to
        // Nav.LocationChanged, re-parse, and unsubscribe in DisposeAsync. (CodeRabbit, PR #362.)
        filter = TaskFilterState.FromUri(Nav.Uri);
        loadedProjectId = Id;
        await LoadProject();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (loadedProjectId != Id)
        {
            loadedProjectId = Id;
            urlSyncCts?.Cancel();
            filter = TaskFilterState.FromUri(Nav.Uri);
            outlineHistory.Clear();
            outlineHistoryIndex = -1;
            expandedFeatures.Clear();
            expandedTasks.Clear();
            outlineExpansionInitialized = false;
            outlineOpen = false;
            detailPanelOpen = editModalOpen = addModalOpen = false;
            selectedTask = null;
            pendingDetailFocusReturnTaskId = detailPanelAddSubtaskParentId = null;
            project = null;
            allTasks = [];
            notFound = false;
            moveError = null;
            aiPanelOpen = false;
            aiContext = null;
            aiNextTasks = [];
            requirementsExpanded = false;
            deepLinkApplied = false;
            sortablesInitialized = false;
            dotNetRef?.Dispose();
            dotNetRef = null;
            await LoadProject();
        }

        if (observedDeepLinkTaskId != DeepLinkTaskId)
        {
            observedDeepLinkTaskId = DeepLinkTaskId;
            deepLinkApplied = false;
        }

        ApplyDeepLinkedTask();
    }

    /// <summary>Opens the task named by <see cref="DeepLinkTaskId"/>, if it exists here.</summary>
    private void ApplyDeepLinkedTask()
    {
        // This panel is controlled by Blazor. Rendering it open during prerender lets
        // Bootstrap's load handler create a second backdrop outside Blazor's ownership.
        if (!RendererInfo.IsInteractive || deepLinkApplied || DeepLinkTaskId is not int taskId) return;
        deepLinkApplied = true;

        var task = allTasks.FirstOrDefault(t => t.Id == taskId);
        if (task is not null)
        {
            OpenTaskDetail(task);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        hasRenderedInteractively = true;

        if (project is not null && !sortablesInitialized)
        {
            sortablesInitialized = true;
            dotNetRef = DotNetObjectReference.Create(this);
            try
            {
                // Small delay to ensure DOM is fully rendered before SortableJS init
                await Task.Delay(100);
                await JS.InvokeVoidAsync("KanbanFlow.initBoardDragDrop", dotNetRef);
                await JS.InvokeVoidAsync("KanbanFlow.initLeftNavDragDrop", dotNetRef);
            }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
            catch (InvalidOperationException) { }
        }

        if (project is not null)
        {
            if (outlineSortablesRefreshPending)
            {
                outlineSortablesRefreshPending = false;
                await ReinitializeSortables();
            }
            try
            {
                await JS.InvokeVoidAsync("KanbanFlow.initProjectOutlineAccessibility");
            }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
            catch (InvalidOperationException) { }
        }

        if (pendingDetailFocusReturnTaskId is int taskId && !detailPanelOpen)
        {
            pendingDetailFocusReturnTaskId = null;
            try
            {
                await JS.InvokeVoidAsync("KanbanFlow.focusTaskCard", taskId);
            }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
            catch (InvalidOperationException) { }
        }
    }

