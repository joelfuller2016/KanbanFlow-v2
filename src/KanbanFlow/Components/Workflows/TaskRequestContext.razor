@inject WorkspaceService Workflow
@if (context is not null && task is not null)
{
    <section class="border rounded p-2 mb-3 bg-light" aria-label="Task request context">
        <a href="@context.BoardUrl">Request: @context.Title</a>
        <div class="small text-muted">Idea #@context.IdeaId · task specification @task.SpecificationVersion</div>
        @if (context.Repositories.FirstOrDefault(r => r.Id == task.Specification.RepositoryId) is { } repository)
        {
            <div class="small mt-2"><strong>@repository.Name</strong> <code>@repository.LocalPath</code></div>
        }
        @if (!string.IsNullOrEmpty(task.Specification.FileReferences)) { <pre class="small mt-2 mb-0" style="white-space:pre-wrap">@task.Specification.FileReferences</pre> }
        <div class="small mt-2">@task.Evidence.Count reported results · @task.Evidence.Count(e => e.Current && e.AcceptedAt is not null) current accepted</div>
        <button class="btn btn-sm btn-link px-0" @onclick="Load">Refresh request context</button>
    </section>
}
@code {
    [Parameter] public int TaskId { get; set; }
    private int loadedId;
    private WorkflowContext? context;
    private WorkflowTaskContext? task;
    protected override async Task OnParametersSetAsync() { if (loadedId != TaskId) { loadedId = TaskId; await Load(); } }
    private async Task Load()
    {
        var request = await Workflow.GetForTaskAsync(TaskId);
        context = request is null ? null : await Workflow.ContextAsync(request.Id);
        task = context?.Tasks.FirstOrDefault(t => t.TaskId == TaskId);
    }
}
