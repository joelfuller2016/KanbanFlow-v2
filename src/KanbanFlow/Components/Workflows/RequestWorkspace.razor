@implements IDisposable
@inject WorkspaceService Workflow
@inject WorkflowOptions Options
@inject ILogger<RequestWorkspace> Logger

<details class="border-bottom bg-light" open="@(IdeaId is not null || RequestId is not null)" data-testid="request-workspace" data-interactive="@interactiveReady.ToString().ToLowerInvariant()">
    <summary class="px-3 py-2 fw-semibold">Requests &amp; plans <span class="text-muted fw-normal">· @requests.Count linked requests</span></summary>
    <div class="p-3" style="max-height: 55vh; overflow:auto">
        <fieldset disabled="@(!interactiveReady)">
        <div class="d-flex flex-wrap gap-2 align-items-end mb-3">
            @if (IdeaId is null)
            {
                <div class="flex-grow-1"><label class="form-label" for="workflow-select">Request</label>
                    <select id="workflow-select" class="form-select" value="@current?.Id" disabled="@WritesBlocked" @onchange="SelectRequest">
                        <option value="">Choose a request</option>
                        @foreach (var request in requests) { <option @key="request.Id" value="@request.Id">@request.Title · @request.DoneCount/@request.TaskCount done @(request.Archived ? "(archived)" : "")</option> }
                    </select>
                </div>
                <button class="btn btn-outline-primary" disabled="@WritesBlocked" @onclick="() => creating = !creating">New request</button>
            }
            <button class="btn btn-outline-secondary" @onclick="RefreshBoard" disabled="@busy">Refresh saved details</button>
            <div><label class="form-label small" for="workflow-actor">Author</label><input id="workflow-actor" class="form-control" @bind="actor" maxlength="200" /></div>
        </div>
        @if (error is not null) { <div role="alert" class="alert alert-danger">@error</div> }
        @if (pendingCommand is not null)
        {
            <div class="alert alert-warning" role="status">
                The original save has not been confirmed. Your draft is kept here. Retry the original save before starting another change.
                <button type="button" class="btn btn-sm btn-outline-primary ms-2" disabled="@busy" @onclick="RetryPending">Retry original save</button>
            </div>
        }
        @if (notice is not null) { <div role="status" class="alert alert-success py-2">@notice</div> }
        @if (creating)
        {
            <form @onsubmit="Capture" @onsubmit:preventDefault class="mb-3">
                <label class="form-label" for="request-title">Request title</label><input id="request-title" class="form-control mb-2" @bind="title" maxlength="200" disabled="@WritesBlocked" required />
                <label class="form-label" for="request-original">Your actual request</label><textarea id="request-original" class="form-control mb-2" rows="4" @bind="original" maxlength="50000" disabled="@WritesBlocked" required></textarea>
                <button class="btn btn-primary" disabled="@WritesBlocked">Capture request</button>
            </form>
        }
        @if (current is null && IdeaId is not null)
        {
            <p>This existing idea can keep its request history here. Its current notes will be labeled as a legacy snapshot.</p>
            <button class="btn btn-primary" disabled="@WritesBlocked" @onclick="Adopt">Start request history</button>
        }
        @if (current is not null)
        {
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                <div><strong>@current.Title</strong><span class="text-muted ms-2">Idea #@current.IdeaId · @current.IdeaStatus · version @current.Version</span></div>
                @if (current.BoardUrl is not null) { <a href="@current.BoardUrl">Open project board</a> }
            </div>
            <p class="small text-muted">Original request → improved brief → task plan → board cards → reviewed results. Refresh reads AI updates while keeping your draft fields.</p>
            @if (current.ProjectId is null)
            {
                <div class="d-flex gap-2 mb-3 align-items-end">
                    <div class="flex-grow-1"><label for="request-project" class="form-label">Project</label><select id="request-project" class="form-select" @bind="attachProject" disabled="@WritesBlocked">
                        <option value="0">Choose an existing project</option>
                        @foreach (var project in projects) { <option @key="project.Id" value="@project.Id">@project.Name</option> }
                    </select></div>
                    <button class="btn btn-outline-primary" @onclick="Attach" disabled="@(WritesBlocked || attachProject == 0)">Promote into project</button>
                    <button class="btn btn-outline-primary" @onclick="CreateProject" disabled="@WritesBlocked">Create project from request</button>
                </div>
            }
            @if (current.NeedsBriefReview && current.Briefs.Count > 0) { <p class="alert alert-info">New clarification or a decision needs review in the brief and plan before publishing or concluding.</p> }
            <fieldset disabled="@WritesBlocked">
                <RequestDetails @key="current.Id" Context="current" OnSubmit="Submit" />
            </fieldset>
            <button class="btn btn-sm btn-outline-secondary mt-3" disabled="@WritesBlocked" @onclick="Archive">@(current.Archived ? "Restore request" : "Archive request")</button>
        }
        </fieldset>
    </div>
</details>

@code {
    [Parameter] public int? ProjectId { get; set; }
    [Parameter] public int? IdeaId { get; set; }
    [Parameter] public Guid? RequestId { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    private List<RequestSummary> requests = [];
    private List<KanbanFlow.Models.Workflows.ProjectSummary> projects = [];
    private WorkflowContext? current;
    private (int?, int?, Guid?) loaded;
    private bool initialized, busy, creating, interactiveReady;
    private string actor = "Human", title = "", original = "";
    private string? error, notice;
    private int attachProject;
    private int _refreshGen;
    private CancellationTokenSource scopeCancellation = new();
    private CancellationTokenSource? readCancellation;
    private bool disposed;
    private WorkflowCommandInput? pendingCommand;
    private WorkflowSubmission? pendingSubmission;
    private bool WritesBlocked => busy || pendingCommand is not null;

    protected override async Task OnParametersSetAsync()
    {
        var scope = (ProjectId, IdeaId, RequestId);
        if (!initialized || loaded != scope)
        {
            scopeCancellation.Cancel(); scopeCancellation.Dispose(); scopeCancellation = new();
            pendingCommand = null; pendingSubmission = null;
            initialized = true; loaded = scope; current = null; await Refresh();
        }
    }
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) { interactiveReady = true; StateHasChanged(); }
    }
    private async Task RefreshBoard()
    {
        await Refresh();
        await OnChanged.InvokeAsync();
    }
    private async Task Refresh()
    {
        var gen = ++_refreshGen;
        var ct = BeginRead();
        try
        {
            var reqs = await Workflow.RequestsAsync(ProjectId, ct);
            var projs = await Workflow.ProjectsAsync(ct);
            var id = current?.Id ?? RequestId;
            if (IdeaId is int ideaId) id = (await Workflow.GetForIdeaAsync(ideaId, ct))?.Id;
            var ctx = id is Guid requestId ? await Workflow.ContextAsync(requestId, ct) : null;
            if (ctx is not null && ProjectId is int projectId && ctx.ProjectId != projectId) ctx = null;
            if (gen != _refreshGen) return;
            requests = reqs; projects = projs; current = ctx;
            error = null;
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
        catch (WorkflowException ex) { if (gen == _refreshGen) error = ex.Message; }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not refresh the request workspace");
            if (gen == _refreshGen && !ct.IsCancellationRequested && !disposed)
                error = "Saved request details could not be refreshed. Your loaded details and draft are kept; try refreshing again.";
        }
    }
    private async Task SelectRequest(ChangeEventArgs e)
    {
        if (WritesBlocked) return;
        var gen = ++_refreshGen;
        var ct = BeginRead();
        try
        {
            var context = Guid.TryParse(e.Value?.ToString(), out var id) ? await Workflow.ContextAsync(id, ct) : null;
            if (context is not null && ProjectId is int projectId && context.ProjectId != projectId) context = null;
            if (gen != _refreshGen || disposed) return;
            current = context;
            error = notice = null;
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
        catch (WorkflowException ex) { if (gen == _refreshGen) error = ex.Message; }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not select a request in the workspace");
            if (gen == _refreshGen && !ct.IsCancellationRequested && !disposed)
                error = "That request could not be loaded. Your current details and draft are kept; try selecting it again.";
        }
    }
    private CancellationToken BeginRead()
    {
        readCancellation?.Cancel(); readCancellation?.Dispose();
        readCancellation = CancellationTokenSource.CreateLinkedTokenSource(scopeCancellation.Token);
        return readCancellation.Token;
    }
    public void Dispose()
    {
        disposed = true; ++_refreshGen;
        scopeCancellation.Cancel(); readCancellation?.Cancel();
        readCancellation?.Dispose(); scopeCancellation.Dispose();
    }
    private async Task Submit(WorkflowSubmission submission)
    {
        if (WritesBlocked) return;
        var command = System.Text.Json.JsonSerializer.Deserialize<WorkflowCommandInput>(
            System.Text.Json.JsonSerializer.Serialize(submission.Command))!;
        command.Actor = actor; command.Key = string.IsNullOrEmpty(command.Key) ? Guid.NewGuid().ToString() : command.Key;
        command.RequestId ??= current?.Id; command.ExpectedVersion ??= current?.Version;
        pendingCommand = command; pendingSubmission = submission;
        await RetryPending();
    }
    private async Task RetryPending()
    {
        if (busy || pendingCommand is not { } command || pendingSubmission is not { } submission) return;
        busy = true; error = notice = null;
        var ct = scopeCancellation.Token;
        try
        {
            var result = await Workflow.ExecuteAsync(command, Options, ct);
            if (command.Operation == "create_project")
            {
                result = await Workflow.ExecuteAsync(new() { Operation = "attach_project", Actor = command.Actor,
                    Key = command.Key + "-attach", RequestId = command.RequestId, ExpectedVersion = command.ExpectedVersion,
                    ProjectId = result.ResourceId }, Options, ct);
            }
            var updated = result.RequestId is Guid id ? await Workflow.ContextAsync(id, ct) : current;
            ct.ThrowIfCancellationRequested();
            current = updated;
            pendingCommand = null; pendingSubmission = null;
            if (command.Operation == "capture") { creating = false; title = original = ""; }
            submission.Succeeded = true; submission.Version = result.Version; submission.Context = current; notice = "Saved to this board.";
            submission.OnConfirmed?.Invoke(submission);
            await Refresh();
            ct.ThrowIfCancellationRequested();
            await OnChanged.InvokeAsync();
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
        catch (Exception ex) when (ex is WorkflowException or ValidationException or DefinitionOfDoneNotMetException or ProjectNotFoundException or IdeaNotFoundException)
        {
            if (!ct.IsCancellationRequested)
            {
                pendingCommand = null; pendingSubmission = null;
                error = ex.Message;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not confirm a request workspace save");
            if (!ct.IsCancellationRequested && !disposed)
                error = submission.Succeeded
                    ? "The save is confirmed, but related board details could not be refreshed. Your draft is kept; refresh saved details to try again."
                    : "The save could not be confirmed. Your draft is kept; retry the original save to check its result safely.";
        }
        finally { busy = false; }
    }
    private Task Capture() => Submit(new(new() { Operation = "capture", Capture = new(title, original, ProjectId) }));
    private Task Adopt() => Submit(new(new() { Operation = "adopt_idea", IdeaId = IdeaId }));
    private Task Attach() => Submit(new(new() { Operation = "attach_project", ProjectId = attachProject }));
    private Task Archive() => Submit(new(new() { Operation = "archive", Archived = !current!.Archived }));
    private Task CreateProject() => current is null ? Task.CompletedTask :
        Submit(new(new() { Operation = "create_project", Name = current.Title }));
}
