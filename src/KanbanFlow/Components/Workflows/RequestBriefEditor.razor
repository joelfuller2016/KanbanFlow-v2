<h3 class="h5">Improved brief</h3>
<p class="small text-muted">Rewrite the request into a clear prompt. Saving creates a revision and leaves the original intact.</p>
@if (version != Context.Version)
{
    <div class="alert alert-info">The saved request changed. Review its history before combining your draft with the current request.
        <button class="btn btn-sm btn-outline-primary ms-2" @onclick="() => version = Context.Version">Keep draft and use current request version</button>
    </div>
}
<form @onsubmit="Save" @onsubmit:preventDefault>
    <label for="brief-outcome" class="form-label">Desired outcome</label><textarea id="brief-outcome" class="form-control mb-2" rows="3" @bind="outcome" maxlength="10000" required></textarea>
    <label for="brief-scope" class="form-label">Scope</label><textarea id="brief-scope" class="form-control mb-2" rows="2" @bind="scope" maxlength="10000"></textarea>
    <label for="brief-constraints" class="form-label">Constraints and assumptions</label><textarea id="brief-constraints" class="form-control mb-2" rows="2" @bind="constraints" maxlength="10000"></textarea>
    <label for="brief-acceptance" class="form-label">Acceptance outcomes</label><textarea id="brief-acceptance" class="form-control mb-2" rows="3" @bind="acceptance" maxlength="10000" required></textarea>
    <button class="btn btn-primary">Save brief revision</button>
    <button type="button" class="btn btn-link" @onclick="LoadSaved">Replace fields with latest saved brief</button>
    <span class="small text-muted">Editing from request version @version</span>
</form>
<details class="mt-3"><summary>Brief history (@Context.Briefs.Count)</summary>
    @foreach (var brief in Context.Briefs.Reverse())
    {
        <article class="border-top py-2"><strong>Revision @brief.Number · @brief.Author</strong>
            <MarkdownContent Markdown="@($"{brief.Outcome}\n\nScope: {brief.Scope}\n\nConstraints: {brief.Constraints}\n\nAcceptance: {brief.Acceptance}")" />
        </article>
    }
</details>
@code {
    [Parameter, EditorRequired] public WorkflowContext Context { get; set; } = null!;
    [Parameter] public EventCallback<WorkflowSubmission> OnSubmit { get; set; }
    private string outcome = "", scope = "", constraints = "", acceptance = "";
    private int version;
    protected override void OnInitialized() => LoadSaved();
    private void LoadSaved()
    {
        var brief = Context.Briefs.LastOrDefault(); version = Context.Version;
        outcome = brief?.Outcome ?? ""; scope = brief?.Scope ?? ""; constraints = brief?.Constraints ?? ""; acceptance = brief?.Acceptance ?? "";
    }
    private async Task Save()
    {
        var submission = new WorkflowSubmission(new() { Operation = "save_brief", ExpectedVersion = version, Brief = new(outcome, scope, constraints, acceptance) });
        await OnSubmit.InvokeAsync(submission);
        if (submission.Succeeded) version = submission.Version!.Value;
    }
}
