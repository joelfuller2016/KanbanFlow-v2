<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <!-- Expose internals (e.g. TestAuditCleanup, #150) to the real-SQLite test project. -->
    <InternalsVisibleTo Include="KanbanFlow.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HtmlSanitizer" Version="9.0.892" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <!-- LLM foundation (#218): provider-agnostic chat client. Microsoft.Extensions.AI
         supplies IChatClient; Microsoft.Extensions.AI.OpenAI is the OpenAI-compatible
         connector we point at ZeroRouter (:5256). Both are stable (non-preview) 10.x,
         pinned to the .NET 10 line like the EF Core packages above. -->
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.8.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.8.0" />
    <!-- Security pin (same pattern as the e_sqlite3 pin below): Microsoft.AspNetCore.OpenApi
         10.0.9 drags in Microsoft.OpenApi 2.0.0, flagged by advisory GHSA-v5pm-xwqc-g5wc
         (circular schema references may terminate OpenAPI parsing; vulnerable 2.x range <= 2.7.4).
         That breaks the -warnaserror PR gate (NU1903). 2.7.5 is the first patched 2.x build and
         satisfies the open-ended minimum without NU1608. Flows transitively into
         KanbanFlow.Tests via the ProjectReference. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.1" />
    <!-- Security pin (#214): EF Core Sqlite 10.0.9 drags in the native SQLite binary
         SQLitePCLRaw.lib.e_sqlite3 2.1.11, flagged by advisory GHSA-2m69-gcr7-jv3q
         (vulnerable range <= 2.1.11). That breaks the -warnaserror PR gate (NU1903).
         3.50.3 is the patched build (bundles SQLite 3.50.3). The bundle/provider
         packages depend on lib.e_sqlite3 with an open-ended minimum (>= 2.1.11), so
         this upgrade satisfies the graph without NU1608 and keeps the managed layer
         EF Core was built against. Only the native lib is flagged, so only it is
         pinned. This flows transitively into KanbanFlow.Tests via the ProjectReference. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Audit suppress: HtmlSanitizer 9.0.892 transitively pulls in AngleSharp 0.17.1,
         flagged by advisory GHSA-pgww-w46g-26qg (moderate; ReDoS in CSS tokeniser).
         A direct version pin cannot be applied without a patched AngleSharp on NuGet;
         suppression unblocks the -warnaserror PR gate until HtmlSanitizer ships with
         AngleSharp >= 0.17.2 or the dependency is replaced under issue #84. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-pgww-w46g-26qg" />
  </ItemGroup>

</Project>
